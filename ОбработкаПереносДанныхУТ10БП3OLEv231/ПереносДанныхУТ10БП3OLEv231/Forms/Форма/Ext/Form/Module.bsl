
&НаСервере
Перем Рубли,В8,УстанавливатьВидНоменклатуры;

&НаКлиенте
Процедура ПолучитьДанные(Команда)  	
	Если ТЗКонтрагентов.Количество()>0 Тогда
		ДополнительныеПараметры = Новый Структура("Действие", "ПолучитьДанные");
		Оповещение = Новый ОписаниеОповещения("ВопросДанныеВТаблицахБудутПерезаполнены", ЭтотОбъект, ДополнительныеПараметры);
		ТекстВопроса = "Данные в таблицах будут перезаполнены, продолжить?";
		Кнопки = РежимДиалогаВопрос.ДаНет;
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
	Иначе
		Состояние("Соединение",1,,Элементы.Индикатор.Картинка);	
		Элементы.Закладки.ТекущаяСтраница=Элементы.Закладки.ПодчиненныеЭлементы.Контрагенты;
		Элементы.Закладки.ПодчиненныеЭлементы.СтраницаПредварительныйПросмотр.Видимость=ложь;
		Объект.ПредварительныйПросмотр.Очистить(); 
		Если Не ЗначениеЗаполнено(Объект.НачПериода) Или Не ЗначениеЗаполнено(Объект.КонПериода)  Тогда 
			Сообщить("Период должен быть заполнен",СтатусСообщения.ОченьВажное);
			Возврат
		КонецЕсли;
		Состояние("Получение данных",10,,Элементы.Индикатор.Картинка); 	
		ПолучитьДанные_сервер();
		Состояние("Получение данных",70,,Элементы.Индикатор.Картинка);	  	
		ПроверитьГотовностьНоменклатуры();
		Состояние("Получение данных",80,,Элементы.Индикатор.Картинка);
		ПроверитьГотовностьКонтрагентов();
		Состояние("Получение данных",90,,Элементы.Индикатор.Картинка);
		ПроверитьГотовностьСкладов();
		Состояние("Получение данных",95,,Элементы.Индикатор.Картинка);
		ПроверитьГотовностьСтатей(); 
		Состояние("Получение данных",100,,Элементы.Индикатор.Картинка);
		
		Если ?(Объект.ВариантВыгрузкиНоменклатуры=0 или Объект.ВариантВыгрузкиНоменклатуры=2 Или Объект.ВариантВыгрузкиНоменклатуры=3,Истина,ЭтаФорма.НоменклатураПроверена) И (ЭтаФорма.КонтрагентыПроверены Или Не ТЗКонтрагентов.Количество()>0) И ?(Объект.ВариантВыгрузкиСкладов=0 или Объект.ВариантВыгрузкиСкладов=2,Истина,ЭтаФорма.СкладыПроверены) Тогда
			Элементы.КнСоздатьДокументы.Доступность=Истина;
			Элементы.КнПредварительныйПросмотр.Доступность=Истина;	 
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредварительныйПросмотр(Команда)
	Состояние("Обработка данных",1,,Элементы.Индикатор.Картинка);
	
	Если Объект.ФильтроватьПоДопРеквизиту Тогда
		Если Не ЗначениеЗаполнено(Объект.ДопРеквизитРеализаций)  Тогда 
			Сообщить("Не заполнено имя доп реквизита. Либо заполните, либо уберите галочку ""Фильтровать продажи по доп реквизиту""",СтатусСообщения.ОченьВажное);
			Возврат
		КонецЕсли; 
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.НачПериода) Или Не ЗначениеЗаполнено(Объект.КонПериода)  Тогда 
		Сообщить("Период должен быть заполнен",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;	
	Элементы.Закладки.ПодчиненныеЭлементы.СтраницаПредварительныйПросмотр.Видимость=Истина;
	Элементы.Закладки.ПодчиненныеЭлементы.СтраницаПредварительныйПросмотр.Доступность=Истина;
	Элементы.Закладки.ТекущаяСтраница=Элементы.Закладки.ПодчиненныеЭлементы.СтраницаПредварительныйПросмотр;
	Объект.ПредварительныйПросмотр.Очистить();
	
	Состояние("Обработка данных",10,,Элементы.Индикатор.Картинка);
	ЗаполнитьПредварительныйПросмотр_Сервер();
	Элементы.Закладки.ТекущаяСтраница=Элементы.Закладки.ПодчиненныеЭлементы.СтраницаПредварительныйПросмотр;
	Элементы.Закладки.ПодчиненныеЭлементы.СтраницаПредварительныйПросмотр.Видимость=Истина;	
	Состояние("Обработка данных",100,,Элементы.Индикатор.Картинка);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредварительныйПросмотр_Сервер()
	ЕстьПомеченныеОбъекты=Ложь;
	Для Каждого ЭлСписка Из Объект.СписокОбъектов Цикл
		Если ЭлСписка.Пометка Тогда
			ЕстьПомеченныеОбъекты=Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ  ЕстьПомеченныеОбъекты Тогда
		Сообщить("В списке объектов для переноса ничего не выбрано!");  
		Возврат; 
	КонецЕсли;
	
	ПТУсСФ=ложь;
	РТУсСФ=ложь;
	ПТУсРегл=ложь;
	РТУсРегл=ложь;
	Рубли=Константы.ВалютаРегламентированногоУчета.Получить();
	
	Контрагент=Справочники.Контрагенты.ПустаяСсылка();
	
	
	//ЭлементыФормы.Панель1.ТекущаяСтраница=ЭлементыФормы.Панель1.Страницы[5];
	В8=Соединение();
	Если В8=Неопределено Тогда
		Сообщить("Не удалось подключиться к БД");
		Возврат;
	КонецЕсли;	
	ПрефиксИБКонстанта=?(ЗначениеЗаполнено(Объект.ПрефиксИсточника),Объект.ПрефиксИсточника,В8.Константы.ПрефиксУзлаРаспределеннойИнформационнойБазы.Получить());
	МассивИНН=В8.NewObject("Массив");
	Для Каждого ЭлСп Из Объект.Организации Цикл
		ОргИзСписка=ЭлСп.Значение;
		Если Не ОргИзСписка.Пустая()  Тогда 
			Если ЗначениеЗаполнено(ОргИзСписка.ИНН) Тогда
				МассивИНН.Добавить(ОргИзСписка.ИНН);
			КонецЕсли;      			 
		КонецЕсли;
	КонецЦикла;  	 
	ДатаТек=ТекущаяДата();
	ФильтроватьДокументы=Ложь; 
	//СтруктураФильтров=Новый Структура("МассивСкладов,МассивРекв",МассивСкладов,МассивРекв);
	СтруктураФильтров=Новый Структура;
	Если Объект.ПерезаписыватьИзменённыеПланОбмена  Или Объект.ДобавлятьИзменённые  Тогда
		Если ЗначениеЗаполнено(Объект.ИмяПланаОбменаИсточника) Тогда
			ВнешняяБазаПриемника=В8.ПланыОбмена[Объект.ИмяПланаОбменаИсточника].НайтиПоКоду(Объект.ПрефиксИБПриемника);	
		Иначе
			ВнешняяБазаПриемника=В8.ПланыОбмена.УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30.НайтиПоКоду(Объект.ПрефиксИБПриемника);	
		КонецЕсли;
		Если ВнешняяБазаПриемника.Code="" Тогда
			Сообщить("Не найдена внешняя база БП, создать узел в плане обмена базы УТ, проверьте префикс ИБ приемника в настройках",СтатусСообщения.ОченьВажное);
			Возврат;
		КонецЕсли;
		СтруктураФильтров.Вставить("ВнешняяБазаПриемника",ВнешняяБазаПриемника);
		ФильтроватьДокументы=Истина; 
		
	КонецЕсли;
	
	//ЭлементыФормы.Индикатор1.Видимость=Истина;
	//ЭлементыФормы.СтатусИндикатора.Видимость=Истина;
	//ЭлементыФормы.СтатусИндикатора.Заголовок="Соединение с базой УТ11";
	СпрНом=Справочники.Номенклатура;
	СпрКонтр=Справочники.Контрагенты;
	НомГТД=Справочники.НомераГТД;
	СпрОрг=Справочники.Организации;
	Если Объект.ВыгружатьПоступления Тогда
		
		Запрос=В8.NewObject("Запрос");
		Запрос.Текст =          "ВЫБРАТЬ
		|	""ПТУ"" КАК Тип,
		|	""Поступление товаров"" КАК признак,
		|	ПоступлениеТоваровУслуг.Номер КАК НомерДок,
		|	ПоступлениеТоваровУслуг.Дата,
		|	ПоступлениеТоваровУслуг.Контрагент,
		|	ПоступлениеТоваровУслуг.Организация,
		|	ПоступлениеТоваровУслуг.СуммаДокумента,
		|	ПоступлениеТоваровУслуг.Контрагент.ИНН,
		|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
		|	ПоступлениеТоваровУслуг.Ссылка,
		|	ЕстьNull(ВЫБОР
		|		КОГДА ПоступлениеТоваровУслуг.СкладОрдер ССЫЛКА Справочник.Склады
		|			ТОГДА ПоступлениеТоваровУслуг.СкладОрдер
		|		ИНАЧЕ ТоварыПТУ.Склад
		|	КОНЕЦ , """")КАК СсылкаСклад,
		|	ЕСТЬNULL(ВложенныйЗапрос.ЕстьСФ, ЛОЖЬ) КАК ЕстьСФ,
		|	ВЫБОР
		|		КОГДА ПоступлениеТоваровУслуг.ОтражатьВБухгалтерскомУчете
		|			ТОГДА ""ЗакупкаУПоставщикаРеглУчет""
		|		ИНАЧЕ ""ЗакупкаУПоставщика""
		|	КОНЕЦ КАК ХозяйственнаяОперация
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(ИСТИНА) КАК ЕстьСФ,
		|			СчетФактураПолученныйДокументыОснования.ДокументОснование КАК ДокументОснование
		|		ИЗ
		|			Документ.СчетФактураПолученный.ДокументыОснования КАК СчетФактураПолученныйДокументыОснования
		|		
		|		СГРУППИРОВАТЬ ПО
		|			СчетФактураПолученныйДокументыОснования.ДокументОснование) КАК ВложенныйЗапрос
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ВложенныйЗапрос.ДокументОснование
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			МАКСИМУМ(ПоступлениеТоваровУслугТовары.Склад) КАК Склад,
		|			ПоступлениеТоваровУслугТовары.Ссылка КАК Ссылка
		|		ИЗ
		|			Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ПоступлениеТоваровУслугТовары.Ссылка) КАК ТоварыПТУ
		|		ПО ПоступлениеТоваровУслуг.Ссылка = ТоварыПТУ.Ссылка
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|	И (ПоступлениеТоваровУслуг.Проведен = ИСТИНА  Или &ПереноситьНепроведенныеДокументы = ИСТИНА) 
		|	И ПоступлениеТоваровУслуг.Организация.ИНН В(&МассивИНН)
		|	И (ПоступлениеТоваровУслуг.ОтражатьВБухгалтерскомУчете = ИСТИНА
		|			ИЛИ &ТолькоДокуменыСпризнакомБУ = ЛОЖЬ)
		|	И (ПоступлениеТоваровУслуг.ОтражатьВБухгалтерскомУчете = Ложь
		|			ИЛИ &ТолькоДокуменыБезПризнакаБУ = ЛОЖЬ)
		|ИТОГИ ПО
		|	ОрганизацияИНН";
		
		ПустойКонтр=СпрКонтр.ПустаяСсылка();
		ПустаяОрг=СпрОрг.ПустаяСсылка();
		Запрос.УстановитьПараметр("ПереноситьНепроведенныеДокументы",Объект.ПереноситьНепроведенныеДокументы);
		Запрос.УстановитьПараметр("ДатаНач",Объект.НачПериода);
		Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.КонПериода));
		Запрос.УстановитьПараметр("МассивИНН",МассивИНН);
		Запрос.УстановитьПараметр("ТолькоДокуменыСпризнакомБУ",Объект.ТолькоДокуменыСпризнакомБУ);
		Запрос.УстановитьПараметр("ТолькоДокуменыБезПризнакаБУ",Объект.ТолькоДокуменыБезПризнакаБУ);
		Результат = Запрос.Выполнить();
		
		//ЭлементыФормы.Индикатор1.МинимальноеЗначение=0; 
		ВыборкаДетальныеЗаписи = Результат.Выбрать(В8.ОбходРезультатаЗапроса.ПоГруппировкам,"ОрганизацияИНН");
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Орган=ВыборкаДетальныеЗаписи.ОрганизацияИНН;
			Орг=ПустаяОрг;
			Если НЕ  ЗначениеЗаполнено(Орган) Тогда			
				Продолжить;	
			КонецЕсли;
			Орг=НайтиОрганизацию(Орган);
			Если Не ЗначениеЗаполнено(Орг) Тогда 
				Сообщить("Не найдена организация с ИНН "+ Орган+" документы по ней загружены не будут",СтатусСообщения.ОченьВажное);
				Продолжить;
			КонецЕсли;
			
			ВыборкаКонтрагент=ВыборкаДетальныеЗаписи.Выбрать(В8.ОбходРезультатаЗапроса.ПоГруппировкам,);
			//ЭлементыФормы.СтатусИндикатора.Заголовок="Получение приходных документов организации "+Орг.Наименование;
			//ЭлементыФормы.Индикатор1.Значение=1;
			Пока ВыборкаКонтрагент.Следующий() Цикл
				Если ФильтроватьДокументы Тогда
					Если Не ДокументПрошёлФильтр(ВыборкаКонтрагент.Ссылка,СтруктураФильтров,В8) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли; 
				
				ВыбКонтр=ВыборкаКонтрагент.Контрагент;
				ВыбКонтрИНН=ВыборкаКонтрагент.КонтрагентИНН;
				// ВыбКонтрНаименование=ВыборкаКонтрагент.КонтрагентНаименование;
				УИН=В8.String(ВыбКонтр.УникальныйИдентификатор());
				СтруктураПоиска=Новый Структура("УИН,Организация,Операция,Валюта");
				СтруктураПоиска.УИН =УИН;
				СтруктураПоиска.Организация =Орг;
				Валюта=НайтиСоздатьВалюту(ВыборкаКонтрагент.Ссылка.ВалютаДокумента);
				СтруктураПоиска.Валюта =Валюта;
				СтруктураПоиска.Операция=ВыборкаКонтрагент.Признак;
				СтрокиКонтр=ТЗКонтрагентов.НайтиСтроки(СтруктураПоиска);
				УИНДок = В8.String(ВыборкаКонтрагент.Ссылка.УникальныйИдентификатор());
				Статус="";
				Если Объект.ЗаписыватьСоответствияДокументов И Не Объект.ПривязкаНеДляПоискаДокументов Тогда
					ДокументСсылкаПриёмник=ПолучитьОбъектИзID(УИНДок, Объект.ВнешняяБаза);
					Если Не ДокументСсылкаПриёмник = Неопределено И Не Объект.ПерезаписыватьВыгруженныеДокументы Тогда
						Статус="Будет пропущен";
					КонецЕсли;
					Если ДокументСсылкаПриёмник = Неопределено Тогда
						Статус="Будет создан";
					Иначе
						Статус="Будет перезаписан";
					КонецЕсли;
				Иначе
					Если Объект.Нумерация=0 Тогда
						ДокументСсылкаПриёмник=Документы.ПоступлениеТоваровУслуг.НайтиПоНомеру(?(Объект.УбиратьИзНомераПрефиксРаспределеннойБазы,СтрЗаменить(ВыборкаКонтрагент.НомерДок,ПрефиксИБКонстанта,""),ВыборкаКонтрагент.НомерДок),ВыборкаКонтрагент.Дата); 
						Если Не ДокументСсылкаПриёмник.Пустая() И Не Объект.ПерезаписыватьВыгруженныеДокументы Тогда
							Статус="Будет пропущен"; 
						ИначеЕсли Не ДокументСсылкаПриёмник.Пустая() Тогда
							Статус="Будет перезаписан";  
						Иначе
							Статус="Будет создан";
						КонецЕсли;   					  
					Иначе
						Статус="Будет создан";
					КонецЕсли;
				КонецЕсли;
				//ДокПТУ=ДокументПриёмник;
				Если СтрокиКонтр.Количество()=0 Тогда
					Сообщить("Не найден контрагент "+ВыбКонтр.Наименование+", документы по нему не будут загружены");
					//ЭлементыФормы.Индикатор1.Значение=ЭлементыФормы.Индикатор1.Значение+1;				
					Продолжить;
				КонецЕсли;
				СтрКонтрагент=СтрокиКонтр[0];
				Контр=СтрКонтрагент.Контрагент;
				Если Не Значениезаполнено(Контр) Тогда
					Сообщить("Не найден контрагент "+ВыбКонтр.Наименование+", документы по нему не будут загружены");
					//	ЭлементыФормы.Индикатор1.Значение=ЭлементыФормы.Индикатор1.Значение+1;				
					Продолжить;
