	ТекДанные=Элементы.ТЗНоменклатуры.ТекущиеДанные;
	//Если НЕ ЗначениеЗаполнено(ТекДанные) Тогда 
	//	Возврат;
	//КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
		Если ЗначениеЗаполнено(Объект.ВнешняяБаза) Тогда
			ОчиститьПривязку(ТекДанные.УИН, Объект.ВнешняяБаза);
			ТекДанные.ЭлементПривязан=Ложь;
			Номенклатура=ПолучитьОбъектИзID(ТекДанные.УИНРод, Объект.ВнешняяБаза);
			Если НЕ Номенклатура=Неопределено Тогда
				ТекДанные.Номенклатура=Номенклатура;
				Возврат;
			КонецЕсли;
			ПроверитьГотовностьНоменклатуры(Ложь);
		КонецЕсли;
		Возврат;
	КонецЕсли; 
	Если Объект.ЗаписыватьСоответствияДокументов Тогда
		Если Вопрос(НСтр("ru = 'Записать соответствие номенклатуры?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Если ЗначениеЗаполнено(Объект.ВнешняяБаза) Тогда
				ЗаписатьПривязку(ТекДанные.Номенклатура, ТекДанные.УИН, Объект.ВнешняяБаза);
				ТекДанные.ЭлементПривязан=Истина;
			Иначе
				Сообщить("Не найдена внешняя база УТ, соответствие не записано",СтатусСообщения.ОченьВажное);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ПроверитьГотовностьНоменклатуры();
КонецПроцедуры

