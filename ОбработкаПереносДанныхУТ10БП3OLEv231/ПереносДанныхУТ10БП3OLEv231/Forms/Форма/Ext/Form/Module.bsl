Процедура ОбработатьОбъектПередЗаписью(ДокументОбъект,ВыборкаКонтрагент,Отказ) 
	Перем ЗначениеНастройки;
	// Сюда добавляйте свой код по обработке объекта, для сохранения совместимости обновлений	
	
	// Пример )
	
	Если Не Объект.СуммаРаспределенияНаИнвентаризацию=0 И  ТипЗНЧ(ДокументОбъект)=Тип("ДокументОбъект.ИнвентаризацияТоваровНаСкладе")  Тогда  //можно взять этот параметр и из базы, т.е. не вносить изменений в обработку
		ТЧТовары=ДокументОбъект.Товары;
		ОбщаяСумма=ТЧТовары.Итог("Сумма");
		Если Не ОбщаяСумма=0 Тогда
			ДоляРаспределения= Объект.СуммаРаспределенияНаИнвентаризацию/ОбщаяСумма;
			Для Каждого СтрокаТЧ Из ТЧТовары Цикл
				СтрокаТЧ.Сумма=	СтрокаТЧ.Сумма+СтрокаТЧ.Сумма*ДоляРаспределения;
				Если НЕ СтрокаТЧ.Количество=0 Тогда
					СтрокаТЧ.Цена=	СтрокаТЧ.Сумма/СтрокаТЧ.Количество;
				КонецЕсли;     				
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли   Не Объект.СуммаРаспределенияНаИнвентаризацию=0 И  ТипЗНЧ(ДокументОбъект)=Тип("ДокументОбъект.ИнвентаризацияТоваровНаСкладе")  Тогда 
		ТЧТовары=ДокументОбъект.НоменклатураНаСкладе;
		ОбщаяСумма=ТЧТовары.Итог("Сумма");     
		Если Не ОбщаяСумма=0 Тогда
			ДоляРаспределения= Объект.СуммаРаспределенияНаИнвентаризацию/ОбщаяСумма;
			Для Каждого СтрокаТЧ Из ТЧТовары Цикл
				СтрокаТЧ.Сумма=	СтрокаТЧ.Сумма+СтрокаТЧ.Сумма*ДоляРаспределения;
				Если НЕ СтрокаТЧ.Количество=0 Тогда
					СтрокаТЧ.Цена=	СтрокаТЧ.Сумма/СтрокаТЧ.Количество;
				КонецЕсли;     				
			КонецЦикла;
		КонецЕсли;
		
		
	ИначеЕсли  ЕстьПользовательскаяНастройка("НаименованиеКатегорииРасчетовПоДолгосрочнымЗаймам",ЗначениеНастройки) И ТипЗНЧ(ДокументОбъект)=Тип("ДокументОбъект.СписаниеСРасчетногоСчета")  И    ДокументОбъект.ВидОперации=Перечисления.ВидыОперацийСписаниеДенежныхСредств.РасчетыПоКредитамИЗаймам Тогда
		// Если 
		
		Если  ПринадлежитКатегории(ВыборкаКонтрагент.Ссылка.ДоговорКонтрагента,ЗначениеНастройки,В8) Тогда
			ДокументОбъект.СчетУчетаРасчетовСКонтрагентом =ПланыСчетов.Хозрасчетный.ДолгосрочныеКредиты;
			РасшПлатежа=ДокументОбъект.РасшифровкаПлатежа;
			Если  РасшПлатежа.Количество()>0 Тогда
				РасшПлатежа[0].СчетУчетаРасчетовСКонтрагентом= ПланыСчетов.Хозрасчетный.ДолгосрочныеКредиты;
			КонецЕсли;
			
		Иначе
			ДокументОбъект.СчетУчетаРасчетовСКонтрагентом =ПланыСчетов.Хозрасчетный.КраткосрочныеКредиты;
			РасшПлатежа=ДокументОбъект.РасшифровкаПлатежа;
			Если  РасшПлатежа.Количество()>0 Тогда
				РасшПлатежа[0].СчетУчетаРасчетовСКонтрагентом= ПланыСчетов.Хозрасчетный.КраткосрочныеКредиты;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли  ЕстьПользовательскаяНастройка("СтатьиВЗависимостиОтСистемыНалогообложения",ЗначениеНастройки) И ТипЗНЧ(ДокументОбъект)=Тип("ДокументОбъект.СписаниеСРасчетногоСчета")  И    ДокументОбъект.ВидОперации=Перечисления.ВидыОперацийСписаниеДенежныхСредств.ПрочееСписание Тогда
		
		УчетныеПолитики = РегистрыСведений.НастройкиСистемыНалогообложения.СрезПоследних(ДокументОбъект.Дата, Новый Структура("Организация", ДокументОбъект.Организация));
		
		Если УчетныеПолитики.Количество() > 0 Тогда
			НаимСтатьи ="";
			
			ДействующаяУчетнаяПолитика = УчетныеПолитики[0];
			
			Если ДокументОбъект.Организация.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
				Если ДействующаяУчетнаяПолитика.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая И ДействующаяУчетнаяПолитика.ПлательщикЕНВД Тогда   				
					НаимСтатьи = "Расходы на услуги банков(расходы распределяются)";
				ИначеЕсли ДействующаяУчетнаяПолитика.ПлательщикЕНВД Тогда
					НаимСтатьи = "Расходы на услуги банков(ЕНВД)";
				ИначеЕсли  ДействующаяУчетнаяПолитика.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая Тогда
					НаимСтатьи ="Расходы на услуги банков";
				КонецЕсли;
				
			ИначеЕсли ДокументОбъект.Организация.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
				Если ДействующаяУчетнаяПолитика.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая И ДействующаяУчетнаяПолитика.ПлательщикЕНВД Тогда
					НаимСтатьи = "Расходы на услуги банков(расходы распределяются)";
					
					
				ИначеЕсли ДействующаяУчетнаяПолитика.СистемаНалогообложения = Перечисления.СистемыНалогообложения.Общая Тогда
					НаимСтатьи ="Расходы на услуги банков";
				ИначеЕсли ДействующаяУчетнаяПолитика.СистемаНалогообложения = Перечисления.СистемыНалогообложения.ОсобыйПорядок Тогда
					Если ДействующаяУчетнаяПолитика.ПлательщикЕНВД Тогда
						НаимСтатьи = "Расходы на услуги банков(ЕНВД)";
					ИначеЕсли ДействующаяУчетнаяПолитика.ПрименяетсяУСНПатент Тогда
						НаимСтатьи ="";
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НаимСтатьи) Тогда
				СсылкаСтатья=Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию(НаимСтатьи,Истина);
				Если Не  СсылкаСтатья.Пустая() Тогда
					ДокументОбъект.СубконтоДт1 =СсылкаСтатья;
					//РасшПлатежа=ДокументОбъект.РасшифровкаПлатежа;
					//Если  РасшПлатежа.Количество()>0 Тогда
					//	РасшПлатежа[0].СтатьяДвиженияДенежныхСредств= СсылкаСтатья;
					//КонецЕсли;
				Иначе
					Сообщить("Не найдены прочие доходы расходы "+НаимСтатьи);
				КонецЕсли;
				
			КонецЕсли;
			
			
		КонецЕсли;
		
		
	КонецЕсли                          
КонецПроцедуры

Функция	ПринадлежитКатегории(СсылкаНаОбъект,НаименованиеКатегории,В8)
	Запрос=В8.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КатегорииОбъектов.Объект
	|ИЗ
	|	РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектов
	|ГДЕ
	|	КатегорииОбъектов.Объект = &Объект
	|	И КатегорииОбъектов.Категория.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеКатегории);
	Запрос.УстановитьПараметр("Объект", СсылкаНаОбъект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат  Истина;
	КонецЕсли;
	Возврат  Ложь;
	
КонецФункции	

Функция	ЕстьПользовательскаяНастройка(КлючНастроек,ЗначениеНастройки)
	Отбор = Новый Структура("Пользователь,КлючОбъекта,КлючНастроек", ИмяПользователя,КлючОбъекта,КлючНастроек);
	Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
	Если Выборка.Следующий() Тогда 
		ЗначениеНастройки=Выборка.Настройки;
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции	

