Процедура ОбработатьВсеПривязки(Установить,ТЧ,ИмяРеквизита)
	Состояние("Обработка привязок",1,,Элементы.Индикатор.Картинка); 	
	Шаг= ТЧ.Количество()/100;
	Если ЗначениеЗаполнено(Объект.ВнешняяБаза) И НЕ Строка(Объект.ВнешняяБаза)="<>" Тогда  
		к=0;
		Для Каждого СтрокаТЧ из ТЧ Цикл
			к=к+1;
			ШагИндикатора=Цел(к/Шаг);
			Если ШагИндикатора>=2 Тогда
				Состояние("Обработка привязок",ШагИндикатора,,Элементы.Индикатор.Картинка);
			КонецЕсли;
			Если  ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизита])Тогда
				Если Установить Тогда
					Если Не СтрокаТЧ.ЭлементПривязан Тогда
						ЗаписатьПривязку(СтрокаТЧ[ИмяРеквизита], СтрокаТЧ.УИН, Объект.ВнешняяБаза);
						СтрокаТЧ.ЭлементПривязан=Истина;
					КонецЕсли;
				Иначе
					Если  СтрокаТЧ.ЭлементПривязан Тогда
						ОчиститьПривязку(СтрокаТЧ.УИН, Объект.ВнешняяБаза);
						СтрокаТЧ.ЭлементПривязан=Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Состояние("Звершено",100,,Элементы.Индикатор.Картинка);
	Иначе
		Состояние("Проверьте настройки",100,,Элементы.Индикатор.Картинка);
	КонецЕсли;
	
КонецПроцедуры

