Процедура СоздатьКонтрагентов_сервер()
	В8=Неопределено;
	Если Объект.ПереноситьИерархиюКонтрагентов Тогда
		В8=Соединение();
		Если В8=Неопределено Тогда
			Сообщить("Не удалось подключиться к БД");
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	Рубли=Константы.ВалютаРегламентированногоУчета.Получить();
	СпрКонтр=Справочники.Контрагенты;           	 
	Запрос=Новый Запрос;	
	ТЗКонтр=РеквизитФормыВЗначение("ТЗКонтрагентов");
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТЗ",ТЗКонтр);
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.КонтрагентУТ,
	|	Т.ИНН,
	|	Т.КПП,
	|	Т.НаименованиеПолное,
	|	Т.ЮрЛицо,
	|	Т.ФактическийАдрес,
	|	Т.ЮридическийАдрес,
	|	Т.БИК,
	|	Т.НомерСчета,
	|	Т.НеЯвляетсяРезидентом,
	|	ПОДСТРОКА(Т.УИН, 1, 100) КАК УИН,
	|	Т.Контрагент
	|ПОМЕСТИТЬ ВвремТЗ
	|ИЗ
	|	&ТЗ КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВвремТЗ.КонтрагентУТ,
	|	ВвремТЗ.КПП,
	|	ВвремТЗ.НаименованиеПолное,
	|	ВвремТЗ.ЮрЛицо,
	|	ВвремТЗ.ИНН,
	|	ВвремТЗ.УИН,
	|	ВвремТЗ.Контрагент,
	|	ВвремТЗ.ФактическийАдрес,
	|	ВвремТЗ.ЮридическийАдрес,
	|	ВвремТЗ.БИК,
	|	ВвремТЗ.НеЯвляетсяРезидентом,
	|	ВвремТЗ.НомерСчета
	|ИЗ
	|	ВвремТЗ КАК ВвремТЗ
	|ГДЕ
	|	ВвремТЗ.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	
	Таблица_ = Запрос.Выполнить().Выгрузить();
	Запрос.МенеджерВременныхТаблиц.Закрыть();	
	Для Каждого СтрокаКонтр Из Таблица_ Цикл
		НовыйКонтр=СпрКонтр.СоздатьЭлемент();             
		НовыйКонтр.ИНН=СтрокаКонтр.ИНН;
		Если СтрокаКонтр.НеЯвляетсяРезидентом  Тогда
			НовыйКонтр.НалоговыйНомер=СтрокаКонтр.ИНН;
		КонецЕсли; 
		НовыйКонтр.Комментарий=?(Объект.НеДобавлятьДопКомментарий,"","Создан обработкой ""перенос данных из УТ10""");
		
		НовыйКонтр.Наименование=СтрокаКонтр.КонтрагентУТ;                          
		НовыйКонтр.ЮридическоеФизическоеЛицо=?(СтрокаКонтр.ЮрЛицо,Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо,Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
		НовыйКонтр.НаименованиеПолное=СтрокаКонтр.НаименованиеПолное;
		НовыйКонтр.КПП=СтрокаКонтр.Кпп;
		Если Объект.ПереноситьИерархиюКонтрагентов Тогда
			НовыйКонтр.Родитель=ПолучитьГруппуКонтрагентов(СтрокаКонтр.УИН,В8);	
			//Возврат;
		Иначе    			
			НовыйКонтр.Родитель=Объект.ГруппаНовыхКонтрагентов;
		КонецЕсли;
		Если Объект.ВыгружатьКонтактнуюИнформацию   Тогда
			Если ЗначениеЗаполнено(СтрокаКонтр.ФактическийАдрес) Тогда
				МенЗАп=НовыйКонтр.КонтактнаяИнформация.Добавить();
				МенЗАп.Вид=Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
				МенЗАп.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
				//МенЗАп.Объект=НовыйКонтр.Ссылка;            
				МенЗАп.Представление=СтрокаКонтр.ФактическийАдрес;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаКонтр.ЮридическийАдрес) Тогда
				МенЗАп=НовыйКонтр.КонтактнаяИнформация.Добавить();
				МенЗАп.Вид=Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
				МенЗАп.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
				//МенЗАп.Объект=НовыйКонтр.Ссылка; 
				МенЗАп.Представление=СтрокаКонтр.ЮридическийАдрес;
			КонецЕсли;
		КонецЕсли;
		
		
		
		ЗаписатьСправочник(НовыйКонтр); 
		
		СтруктураПоиска=Новый Структура("УИН");
		СтруктураПоиска.УИН =СтрокаКонтр.УИН;
		СтрокиКонтр=ТЗКонтрагентов.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтКонтр Из СтрокиКонтр Цикл
			СтКонтр.Контрагент=НовыйКонтр.Ссылка;
			СтКонтр.Наименование=НовыйКонтр.Наименование;
		КонецЦикла; 
		
		Если Объект.ПереноситьБаковскийСчётКонтрагента   Тогда
			Если ЗначениеЗаполнено(СтрокаКонтр.БИК) И ЗначениеЗаполнено(СтрокаКонтр.НомерСчета) Тогда
				Банк=Справочники.Банки.НайтиПоКоду(СтрокаКонтр.БИК);
				Если Банк.Пустая() Тогда
					Сообщить("Не найден банк с БИК "+СтрокаКонтр.БИК);
					Возврат;
				КонецЕсли; 				                                                  
				БанкСчёт=Справочники.БанковскиеСчета.СоздатьЭлемент();
				БанкСчёт.Владелец=НовыйКонтр.Ссылка; 
				БанкСчёт.НомерСчета=СтрокаКонтр.НомерСчета;
				БанкСчёт.Наименование= СтрокаКонтр.НомерСчета;
				БанкСчёт.ВидСчета="Расчетный";
				БанкСчёт.Банк=Банк;
				БанкСчёт.ВалютаДенежныхСредств=Рубли; 
				ЗаписатьСправочник(БанкСчёт);
				НовыйКонтр.ОсновнойБанковскийСчет=БанкСчёт.Ссылка;
				ЗаписатьСправочник(НовыйКонтр);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

