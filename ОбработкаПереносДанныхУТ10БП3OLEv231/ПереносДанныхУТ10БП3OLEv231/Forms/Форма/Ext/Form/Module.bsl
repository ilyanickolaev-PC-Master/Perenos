Функция ПолучитьДокументПоНомеру(НомерДокПП,ДатаДокПП,Тип)  
	ДокументСсылка=Документы.РеализацияТоваровУслуг.ПустаяСсылка();
	Если Тип="ПТУ" Тогда 
		ДокументСсылка=Документы.ПоступлениеТоваровУслуг.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="РТУ" Тогда 
		ДокументСсылка=Документы.РеализацияТоваровУслуг.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ПКО" Тогда 
		ДокументСсылка=Документы.ПриходныйКассовыйОрдер.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="РКО" Тогда 
		ДокументСсылка=Документы.РасходныйКассовыйОрдер.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Возврат" Тогда 
		ДокументСсылка=Документы.ВозвратТоваровОтПокупателя.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ПБДС" Тогда 
		ДокументСсылка=Документы.ПоступлениеНаРасчетныйСчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="СБДС" Тогда 
		ДокументСсылка=Документы.СписаниеСРасчетногоСчета.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ПОПДС" Тогда 
		ДокументСсылка=Документы.ПоступлениеНаРасчетныйСчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ПОСДС" Тогда 
		ДокументСсылка=Документы.СписаниеСРасчетногоСчета.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ИППер" Тогда 
		ДокументСсылка=Документы.ПоступлениеНаРасчетныйСчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ИППол" Тогда 
		ДокументСсылка=Документы.СписаниеСРасчетногоСчета.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Счёт" Тогда 
		ДокументСсылка=Документы.СчетНаОплатуПокупателю.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="АО" Тогда 
		ДокументСсылка=Документы.АвансовыйОтчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ТН" Тогда 
		ДокументСсылка=Документы.ТребованиеНакладная.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Перем" Тогда 
		ДокументСсылка=Документы.ПеремещениеТоваров.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Спис" Тогда 
		ДокументСсылка=Документы.СписаниеТоваров.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Оприх" Тогда 
		ДокументСсылка=Документы.ОприходованиеТоваров.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ОРП" Тогда 
		ДокументСсылка=Документы.ОтчетОРозничныхПродажах.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Возврат поставщику" Тогда 
		ДокументСсылка=Документы.ВозвратТоваровПоставщику.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Инв" Тогда 
		ДокументСсылка=Документы.ИнвентаризацияТоваровНаСкладе.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Взаимозачет" Или Тип="Списание задолженности поставщику" или Тип="Списание задолженности покупателя"  Тогда 
		ДокументСсылка=Документы.КорректировкаДолга.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Компл" Тогда 
		ДокументСсылка=Документы.КомплектацияНоменклатуры.НайтиПоНомеру(НомерДокПП,ДатаДокПП);	 
	ИначеЕсли Тип="КРТУ" Тогда 
		ДокументСсылка=Документы.КорректировкаРеализации.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ОтчетКоммиссионера" Тогда 
		ДокументСсылка=Документы.ОтчетКомиссионераОПродажах.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ОтчетКомитенту" Тогда 
		ДокументСсылка=Документы.ОтчетКомитентуОПродажах.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Оплата картой" Тогда	
		ДокументСсылка=Документы.ОплатаПлатежнойКартой.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="Поступление доп. расходов" Тогда 
		ДокументСсылка=Документы.ПоступлениеДопРасходов.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="ГТДИмпорт" Тогда	
		ДокументСсылка=Документы.ГТДИмпорт.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	ИначеЕсли Тип="КПТУ" Тогда 
		ДокументСсылка=Документы.КорректировкаПоступления.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
	КонецЕсли;
	
	
	
	Возврат ДокументСсылка; 
КонецФункции

