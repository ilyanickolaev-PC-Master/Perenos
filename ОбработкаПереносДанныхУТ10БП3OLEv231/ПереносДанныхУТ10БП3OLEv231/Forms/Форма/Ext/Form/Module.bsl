Функция ПолучитьКИ(Контрагент,В8)
	Запрос=В8.NewObject("Запрос");
	
	Запрос.Текст= "ВЫБРАТЬ
	|	ФактАдрес.Представление КАК ФактическийАдрес,
	|	ЮрАдрес.Представление КАК ЮридическийАдрес
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ЮрАдрес
	|		ПО Контрагенты.Ссылка = ЮрАдрес.Объект
	|			И (ЮрАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (ЮрАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента))
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК ФактАдрес
	|		ПО Контрагенты.Ссылка = ФактАдрес.Объект
	|			И (ФактАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес))
	|			И (ФактАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента))
	|ГДЕ
	|	Контрагенты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Контрагент); 
	ВыборкаЗапроса=Запрос.Выполнить().Выбрать();	
	Если ВыборкаЗапроса.Следующий() Тогда
		СтруктураКИ=Новый Структура("ФактическийАдрес,ЮридическийАдрес"); 
		СтруктураКИ.ФактическийАдрес=ВыборкаЗапроса.ФактическийАдрес;	
		СтруктураКИ.ЮридическийАдрес=ВыборкаЗапроса.ЮридическийАдрес;	
		Возврат СтруктураКИ;
	Конецесли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиСтатьюЗатратПоКоду(СтатьяЗатратНаименование,СтатьяЗатратКод)
	СпрСтатей=Справочники.СтатьиЗатрат;
	
	Если Не ЗначениеЗаполнено(СтатьяЗатратКод) Тогда
		Возврат  СпрСтатей.ПустаяСсылка();
	КонецЕсли;
	
	НайденаяСтатья=СпрСтатей.НайтиПоКоду(СтатьяЗатратКод);
	Если НайденаяСтатья.Пустая() Тогда
		ЭлСтатей=СпрСтатей.СоздатьЭлемент();
		ЭлСтатей.код=СтатьяЗатратКод;
		ЭлСтатей.Наименование=  СтатьяЗатратНаименование;
		ЗаписатьСправочник(ЭлСтатей);
		НайденаяСтатья=ЭлСтатей.Ссылка;
	КонецЕсли;
	Возврат НайденаяСтатья;
КонецФункции			 

