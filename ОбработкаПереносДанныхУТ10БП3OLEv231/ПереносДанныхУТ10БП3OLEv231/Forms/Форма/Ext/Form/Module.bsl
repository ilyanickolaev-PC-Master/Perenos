&НаСервере
Процедура АктуализироватьАдресаНаСервере()
	Рубли=Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если Не Объект.ВыгружатьКонтактнуюИнформацию Тогда
		Сообщить("Для актуализации адресов необходимо в настройках использовать опцию Выгружать контактную информацию");
		Возврат;	 
	КонецЕсли;
	
	//Ответ = Вопрос("Будут обновлены юр. и факт. адреса контрагентов по данным УТ, продолжить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	//Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
	//	Возврат;
	//КонецЕсли;
	Запрос=Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	ТЗКонтр=РеквизитФормыВЗначение("ТЗКонтрагентов");
	
	Запрос.УстановитьПараметр("ТЗ",ТЗКонтр);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.КонтрагентУТ,
	|	Т.ИНН,
	|	Т.КПП,
	|	Т.НаименованиеПолное,
	|	Т.ЮрЛицо,
	|	ПОДСТРОКА(Т.УИН, 1, 100) КАК УИН,
	|	Т.ФактическийАдрес,
	|	Т.ЮридическийАдрес,
	|	Т.БИК,
	|	Т.НомерСчета,
	|	Т.Контрагент
	|ПОМЕСТИТЬ ВвремТЗ
	|ИЗ
	|	&ТЗ КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВвремТЗ.КонтрагентУТ,
	|	ВвремТЗ.КПП,
	|	ВвремТЗ.НаименованиеПолное,
	|	ВвремТЗ.ЮрЛицо,
	|	ВвремТЗ.ИНН,
	|	ВвремТЗ.УИН,
	|	ВвремТЗ.Контрагент,
	|	ВвремТЗ.ФактическийАдрес,
	|	ВвремТЗ.БИК,
	|	ВвремТЗ.НомерСчета,
	|	ВвремТЗ.ЮридическийАдрес
	|ИЗ
	|	ВвремТЗ КАК ВвремТЗ  ";
	
	
	Таблица_ = Запрос.Выполнить().Выгрузить();
	Запрос.МенеджерВременныхТаблиц.Закрыть();	
	
	
	Для каждого СтрокаКонтр Из Таблица_ Цикл
		КонтрСсылка= СтрокаКонтр.Контрагент;             		
		Если КонтрСсылка.Пустая() Тогда
			Сообщить("Для контрагента УТ "+СтрокаКонтр.КонтрагентУТ+" не заполнен контрагент БП, не у кого обновлять адреса");
			Продолжить;
		КонецЕсли; 
		Месэдж="Контрагент: "+КонтрСсылка.Наименование +" код "+КонтрСсылка.Код+Символы.ПС;
		ОбъектИзменён=Ложь;
		
		Контр=КонтрСсылка.ПолучитьОбъект();
		Если ЗначениеЗаполнено(СтрокаКонтр.ФактическийАдрес) Тогда
			
			СтруктураПоиска=Новый Структура("Вид,Тип");
			СтруктураПоиска.Вид=Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
			СтруктураПоиска.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
			
			СтрокиКИ=Контр.КонтактнаяИнформация.НайтиСтроки(СтруктураПоиска);
			Если СтрокиКИ.Количество()>0 Тогда
				Если СтрокиКИ[0].Представление<>СтрокаКонтр.ФактическийАдрес Тогда
					Месэдж=Месэдж+"Обновлён факт. адрес контрагента с "+СтрокиКИ[0].Представление+" на "+СтрокаКонтр.ФактическийАдрес+Символы.ПС;
					СтрокиКИ[0].Представление=СтрокаКонтр.ФактическийАдрес;
					ОбъектИзменён=Истина;
					//ЗаписатьСправочник(Контр);
					//Сообщить("Обновлён факт. адрес контрагента "+Контр);
				КонецЕсли; 
			Иначе
				МенЗАп=	Контр.КонтактнаяИнформация.Добавить(); 
				МенЗАп.Вид=Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
				МенЗАп.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
				МенЗАп.Представление=СтрокаКонтр.ФактическийАдрес; 
				Месэдж=Месэдж+"Дорбавлен факт. адрес контрагента "+Символы.ПС;
				ОбъектИзменён=Истина;
				
				//ЗаписатьСправочник(Контр);
				//Сообщить("Дорбавлен факт. адрес контрагента "+Контр);
			КонецЕсли;
			
		КонецЕсли;
		
		
		
		Если ЗначениеЗаполнено(СтрокаКонтр.ЮридическийАдрес) Тогда
			
			СтруктураПоиска=Новый Структура("Вид,Тип");
			СтруктураПоиска.Вид=Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
			СтруктураПоиска.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
			
			СтрокиКИ=Контр.КонтактнаяИнформация.НайтиСтроки(СтруктураПоиска);
			Если СтрокиКИ.Количество()>0 Тогда
				Если СтрокиКИ[0].Представление<>СтрокаКонтр.ЮридическийАдрес Тогда
					Месэдж=Месэдж+"Обновлён юр. адрес контрагента с "+СтрокиКИ[0].Представление+" на "+СтрокаКонтр.ЮридическийАдрес+Символы.ПС;
					СтрокиКИ[0].Представление=СтрокаКонтр.ЮридическийАдрес;
					ОбъектИзменён=Истина;
				КонецЕсли; 
			Иначе
				МенЗАп=	Контр.КонтактнаяИнформация.Добавить(); 
				МенЗАп.Вид=Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
				МенЗАп.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
				МенЗАп.Представление=СтрокаКонтр.ЮридическийАдрес; 
				Месэдж=Месэдж+"Дорбавлен юр. адрес контрагента "+Символы.ПС;
				ОбъектИзменён=Истина;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаКонтр.КонтрагентУТ) И Объект.ОбновлятьНаименованияКонтрагентовПриСинхронизации Тогда
			
			Если Контр.Наименование<>СтрокаКонтр.КонтрагентУТ Тогда
				Месэдж=Месэдж+"Обновлёно наименование контрагента с "+Контр.Наименование+" на "+СтрокаКонтр.КонтрагентУТ+Символы.ПС;
				ОбъектИзменён=Истина;
				Контр.Наименование=СтрокаКонтр.КонтрагентУТ; 
			КонецЕсли;
			
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаКонтр.НаименованиеПолное) И Объект.ОбновлятьНаименованияКонтрагентовПриСинхронизации Тогда
			
			Если Контр.НаименованиеПолное<>СтрокаКонтр.НаименованиеПолное Тогда
				Месэдж=Месэдж+"Обновлёно полное наименование  контрагента с "+Контр.НаименованиеПолное+" на "+СтрокаКонтр.НаименованиеПолное+Символы.ПС;
				ОбъектИзменён=Истина;
				Контр.НаименованиеПолное=СтрокаКонтр.НаименованиеПолное; 
			КонецЕсли;
			
		КонецЕсли;
		
		Если ОбъектИзменён Тогда
			Попытка ЗаписатьСправочник(Контр);
				Сообщить(Месэдж);
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;   		  
		КонецЕсли;
		
		
		Если Объект.ПереноситьБаковскийСчётКонтрагента   Тогда
			Если ЗначениеЗаполнено(СтрокаКонтр.БИК) И ЗначениеЗаполнено(СтрокаКонтр.НомерСчета) Тогда
				Банк=Справочники.Банки.НайтиПоКоду(СтрокаКонтр.БИК);
				Если Банк.Пустая() Тогда
					Сообщить("Не найден банк с БИК "+СтрокаКонтр.БИК);
					Возврат;
				КонецЕсли; 
				БанкСчётСсылка=Справочники.БанковскиеСчета.НайтиПоРеквизиту("НомерСчета",СтрокаКонтр.НомерСчета,,КонтрСсылка);
				Если  БанкСчётСсылка.Пустая() Тогда
					БанкСчёт=Справочники.БанковскиеСчета.СоздатьЭлемент();
					БанкСчёт.Владелец=КонтрСсылка; 
					БанкСчёт.НомерСчета=СтрокаКонтр.НомерСчета;
					БанкСчёт.Банк=Банк;
					БанкСчёт.ВалютаДенежныхСредств=Рубли;
					ЗаписатьСправочник(БанкСчёт);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


