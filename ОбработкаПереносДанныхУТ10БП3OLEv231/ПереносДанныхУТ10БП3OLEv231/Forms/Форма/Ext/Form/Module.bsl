&НаКлиенте
Процедура ПометитьНаУдалениеОтмеченные(Команда)
	Для Каждого ТекДанные из Объект.ПредварительныйПросмотр Цикл
		Если Не ТекДанные.Загружать Тогда
			Продолжить;
		КонецЕсли;
		
		Если Объект.ЗаписыватьСоответствияДокументов И Не Объект.ПривязкаНеДляПоискаДокументов Тогда
			ДокументСсылка=ПолучитьОбъектИзID(ТекДанные.УИН, Объект.ВнешняяБаза); 
		Иначе 
			НомерДокПП=ТекДанные.Номер;
			ДатаДокПП=ТекДанные.Дата;
			ДокументСсылка=ПолучитьДокументПоНомеру(НомерДокПП,ДатаДокПП,ТекДанные.Тип);
		КонецЕсли;
		Если ДокументСсылка=Неопределено Тогда
			Продолжить; 
		КонецЕсли;
		ПометитьДокументНаУдаление(ДокументСсылка);
		
	КонецЦикла;
	
	
