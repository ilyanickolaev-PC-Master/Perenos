&НаСервере
Процедура СохранитьНаСервере()
	Для каждого СтрокаТаблицы из ТаблицаДанных Цикл 
		Если СтрокаТаблицы.Изменено и Не СтрокаТаблицы.Коллекция Тогда 
			ХранилищеОбщихНастроек.Сохранить(СтрокаТаблицы.КлючОбъекта, СтрокаТаблицы.КлючНастроек, СтрокаТаблицы.Значение, , ИмяПользователя);
		КонецЕсли;
		СтрокаТаблицы.Изменено = Ложь;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьТекстЯчейкиОбласти(Область,Строка,Колонка) Экспорт
	Возврат Строка(Область.ПолучитьОбласть("R"+Формат(Строка,"ЧГ=0")+"C"+Формат(Колонка,"ЧГ=0")).ТекущаяОбласть.Текст);
КонецФункции
&НаСервере
Функция ПолучитьКодТНВЭД(КодТНВЭД)
	СправочникТНВЭД=Справочники.КлассификаторТНВЭД;
	СпрТНВЭД=СправочникТНВЭД.НайтиПоКоду(КодТНВЭД);
	Если Не СпрТНВЭД.Пустая()  Тогда
		
		Возврат СпрТНВЭД;	
		
	КонецЕсли; 
	
	Макет=СправочникТНВЭД.ПолучитьМакет("КлассификаторТоварнойНоменклатурыВнешнеэкономическойДеятельности");
	Если  Макет.Области.Найти("Строки")=Неопределено Тогда
		Возврат СправочникТНВЭД.ПустаяСсылка();
	КонецЕсли;                                                                                                  
	
	Область=Макет.ПолучитьОбласть("Строки");     
	Для Сч=1 По Область.ВысотаТаблицы Цикл
		промКод	=	ПолучитьТекстЯчейкиОбласти(Область,Сч,1);	
		Если промКод=КодТНВЭД Тогда
			промНаименование			=	ПолучитьТекстЯчейкиОбласти(Область,Сч,2);
			промЕдИзм				=	ПолучитьТекстЯчейкиОбласти(Область,Сч,3);
			ЭлементКлассификатора = СправочникТНВЭД.СоздатьЭлемент();
			ЭлементКлассификатора.Код=промКод;
			ЭлементКлассификатора.НаименованиеПолное = промНаименование;
			ЭлементКлассификатора.Наименование = промНаименование;
			ЭлементКлассификатора.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду(промЕдИзм);  	
			ЭлементКлассификатора.Записать();
			Возврат ЭлементКлассификатора.Ссылка;
		КонецЕсли; 
	КонецЦикла;
	Возврат СправочникТНВЭД.ПустаяСсылка();
КонецФункции 	


Процедура УчестьХарактеристику(УИННом,ВыбНомНаименование,ВыбНомНаименованиеПолное,Н,НаименованиеХарактеристики,Характеристика,В8)
