			|			КОГДА ПТУ.Ссылка.СкладОрдер ССЫЛКА Справочник.Склады
			|				ТОГДА ПТУ.Ссылка.СкладОрдер
			|			ИНАЧЕ ПТУ.Склад
			|		КОНЕЦ КАК СсылкаСклад,
			|		ПТУ.Номенклатура.Код КАК НоменклатураКод,
			|		ЕСТЬNULL(ПТУ.СерияНоменклатуры.НомерГТД.Код, """") КАК НомерГТД,
