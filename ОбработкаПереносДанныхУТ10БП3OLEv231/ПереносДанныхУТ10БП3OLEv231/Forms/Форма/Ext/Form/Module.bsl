								СтрокаТоваров.Коэффициент=1;         							
								СтрокаТоваров.Цена=СтрокаТоваров.Сумма/СтрокаТоваров.Количество;
								СтрокаТоваров.ЕдиницаИзмерения =шт; 							
							КонецЕсли;
							СтрокаТоваров.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
							СведенияОНоменклатуре = БухгалтерскийУчетПереопределяемый.ПолучитьСведенияОНоменклатуре(СтрокаТоваров.Номенклатура,ДанныеОбъекта);
							Документы.ПоступлениеТоваровУслуг.ЗаполнитьСчетаУчетаВСтрокеТабличнойЧасти(ДанныеОбъекта, СтрокаТоваров, "Товары", СведенияОНоменклатуре);
						КонецЦикла;
						Если СоздаватьУЦ Тогда
							ДокУЦ.Товары.Свернуть("Номенклатура,Валюта","Цена");
