Процедура ТипСоединенияПриИзменении(Элемент)
	ФДост=?(Объект.ТипСоединения=1,Ложь,Истина);	
	ЭтаФорма.Элементы.Путь.Доступность	=ФДост;	
	ЭтаФорма.Элементы.Сервер.Доступность=НЕ ФДост;
	ЭтаФорма.Элементы.База.Доступность	=НЕ ФДост;
КонецПроцедуры
&НаКлиенте 
Процедура ОбновитьЭлементыФормы()
	Если Объект.ПрефиксИБ="" Тогда
		//Объект.ПрефиксИБ= "UT";
	КонецЕсли; 
	ФДост=?(Объект.ТипСоединения=1,Ложь,Истина);	
	ЭтаФорма.Элементы.Путь.Доступность	=ФДост;	
	ЭтаФорма.Элементы.Сервер.Доступность=НЕ ФДост;
	ЭтаФорма.Элементы.База.Доступность	=НЕ ФДост;
	//ЭтаФорма.Элементы.ПрефиксИБ.Видимость=Объект.ЗаписыватьСоответствияДокументов;
	ФДост=?(Объект.ТипЦен=0,Ложь,Истина);	
	ЭтаФорма.Элементы.ИдентификаторЦены.Доступность= ФДост;
	ЭтаФорма.Элементы.ИдентификаторЦены.Видимость	= ФДост;
	ЭтаФорма.Элементы.ДопРеквизитРеализаций.Видимость=Объект.ФильтроватьПоДопРеквизиту;
	ВидимостьНоменклатуры=Объект.ВариантВыгрузкиНоменклатуры=0 Или Объект.ВариантВыгрузкиНоменклатуры=2  Или Объект.ВариантВыгрузкиНоменклатуры=3;
	ЭтаФорма.Элементы.Закладки.ПодчиненныеЭлементы.Номенклатура.Видимость=Не ВидимостьНоменклатуры;
	ЭтаФорма.Элементы.Закладки.ПодчиненныеЭлементы.Номенклатура.Доступность=Не ВидимостьНоменклатуры;
	ЭтаФорма.Элементы.ПоказыватьСеанс.Видимость=?(Объект.ТипКоннектора=0,ложь,истина);
	ЭтаФорма.Элементы.ПрефиксИБ.Видимость=Объект.ЗаписыватьСоответствияДокументов; 
	ЭтаФорма.Элементы.ПривязкаНеДляПоискаДокументов.Видимость=Объект.ЗаписыватьСоответствияДокументов; 
	ЭтаФорма.Элементы.ФормулаНаименованияНоменклатуры.Видимость=Объект.ТоварЭтоХарактеристика;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписыватьСоответствияДокументовПриИзменении(Элемент)
	ОбновитьЭлементыФормы();
КонецПроцедуры

&НаКлиенте
Процедура ТипЦенПриИзменении(Элемент)
	ФДост=?(Объект.ТипЦен=0,Ложь,Истина);	
	ЭтаФорма.Элементы.ИдентификаторЦены.Доступность= ФДост;
	ЭтаФорма.Элементы.ИдентификаторЦены.Видимость	= ФДост;
