							СтрокаПТУ=ДокПТУ.Товары.Добавить();
							СтрокаПТУ.Номенклатура =НайденаяНом;
							СтрокаПТУ.Количество =ВыборкаНоменклатура.Количество;
							СтрокаПТУ.Цена =ЦенаБух;
							СтрокаПТУ.Сумма=СуммаБух;
