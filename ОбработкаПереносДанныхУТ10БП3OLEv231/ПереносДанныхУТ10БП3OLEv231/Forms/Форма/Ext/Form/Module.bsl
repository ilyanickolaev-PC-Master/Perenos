					ЗаписатьСправочник(НовНом);
					Возврат НовНом.Ссылка;
				Иначе
					Возврат  НайденаяНом; 
				КонецЕсли;    				
			Иначе 
				Возврат Объект.НоменклатураЗамены;		
			КонецЕсли;
		Иначе
			
			СтруктураПоиска=Новый Структура("УИН");
			СтруктураПоиска.Уин=УИННом;
