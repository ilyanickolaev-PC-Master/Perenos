			|		ПТУ.Количество * ПТУ.Коэффициент КАК Количество,
			|		ПТУ.СтавкаНДС КАК СтавкаНДС,
			|		ПТУ.Ссылка.Дата КАК Дата,
			|		ПТУ.Ссылка КАК Ссылка,
			|		ВЫБОР
			|			КОГДА ПТУ.Ссылка.УчитыватьНДС
			|				ТОГДА ИСТИНА
			|			ИНАЧЕ ЛОЖЬ
			|		КОНЕЦ КАК УчитыватьНДС,
			|		ПТУ.СуммаНДС КАК СуммаНДС,
			|		ПТУ.Сумма КАК Сумма,
			|		ЛОЖЬ КАК Услуга,
			|		"""" КАК Содержание,
			|		"""" КАК СтатьяЗатратНаименование,
			|		"""" КАК СтатьяЗатратКод
			|	ИЗ
			|		Документ.ПоступлениеТоваровУслуг.Товары КАК ПТУ
			|	ГДЕ
			|		ПТУ.Ссылка.Дата МЕЖДУ &ДатаНач И &ДатаКон
			|		И (ПТУ.Ссылка.Проведен = ИСТИНА
			|				ИЛИ &ПереноситьНепроведенныеДокументы = ИСТИНА)
			|		И ПТУ.Ссылка.Организация.ИНН В(&МассивИНН)
			|		И (ПТУ.Ссылка.ОтражатьВБухгалтерскомУчете = ИСТИНА
			|				ИЛИ &ТолькоДокуменыСпризнакомБУ = ЛОЖЬ)
			|		И (ПТУ.Ссылка.ОтражатьВБухгалтерскомУчете = ЛОЖЬ
			|				ИЛИ &ТолькоДокуменыБезПризнакаБУ = ЛОЖЬ)
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ПТУ.Ссылка.Контрагент,
			|		ПТУ.Ссылка.Контрагент.ИНН,
			|		ПТУ.Ссылка.Контрагент.Наименование,
			|		ПТУ.Ссылка.Организация.ИНН,
			|		ПТУ.Ссылка.Номер,
			|		ПТУ.Ссылка.СуммаВключаетНДС,
			|		ПТУ.Ссылка.НомерВходящегоДокумента,
			|		ПТУ.Ссылка.ДатаВходящегоДокумента,
			|		ПТУ.Ссылка.СуммаДокумента,
			|		ПТУ.Ссылка.СкладОрдер.Наименование,
			|		ПТУ.Ссылка.СкладОрдер,
			|		ПТУ.Номенклатура.Код,
			|		"""",
			|		"""",
			|		ПТУ.Номенклатура,
			|		ПТУ.Цена,
			|		ПТУ.Номенклатура.Наименование,
			|		ПТУ.Номенклатура.НаименованиеПолное,
			|		ПТУ.Номенклатура.Артикул,
			|		ПТУ.Номенклатура.НоменклатурнаяГруппа.Наименование,
