&НаСервере  
Функция НайтиСоздатьВалюту(Валюта)
	ВалютаСсылка=Справочники.Валюты.НайтиПоКоду(Валюта.Код);
	Если  ВалютаСсылка.Пустая() Тогда                                 
		НовВалюта=Справочники.Валюты.СоздатьЭлемент();
		НовВалюта.Наименование= Валюта.Наименование;
		НовВалюта.Код= Валюта.Код;
		НовВалюта.НаименованиеПолное= Валюта.НаименованиеПолное;
		Если ЕстьРеквизитОбъекта("ПараметрыПрописиНаРусском",  Метаданные.Справочники.Валюты) Тогда
			НовВалюта.ПараметрыПрописиНаРусском= Валюта.ПараметрыПрописиНаРусском;
		КонецЕсли;
		Если ЕстьРеквизитОбъекта("ПараметрыПрописи",  Метаданные.Справочники.Валюты) Тогда
			НовВалюта.ПараметрыПрописи= Валюта.ПараметрыПрописи;
		КонецЕсли;                                               
		ЗаписатьСправочник(НовВалюта);
		ВалютаСсылка=НовВалюта.Ссылка;	
		Сообщить("Создана валюта "+Валюта.Наименование);
	КонецЕсли;
	Возврат ВалютаСсылка;	
	
КонецФункции
&НаСервере
Функция ПолучитьКурсВалюты(Валюта, ДатаКурса,В8) 
	Результат = В8.РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДатаКурса,В8.NewObject("Структура","Валюта",Валюта));
	
	Результат.Вставить("Валюта",    Валюта);
	Результат.Вставить("ДатаКурса", ДатаКурса);
	
	Возврат Результат;
	
КонецФункции

