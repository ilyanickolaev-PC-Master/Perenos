								КонецЕсли;
							КонецЕсли; 						
							НайденныйГТД=НомГТД.ПустаяСсылка();
							Если ЗначениеЗаполнено(НомерГТД) Тогда
								НайденныйГТД=НомГТД.НайтиПоКоду(СокрЛП(НомерГТД));
								Если НайденныйГТД.Пустая()   Тогда
									НовГТД= НомГТД.СоздатьЭлемент();
									НовГТД.Код=СокрЛП(НомерГТД);
									НовГТД.Комментарий=?(Объект.НеДобавлятьДопКомментарий,"","Создан обработкой ""перенос данных из УТ10""");
									Если ЕстьРеквизитОбъекта("РегистрационныйНомер",  Метаданные.Справочники.НомераГТД) Тогда
										НовГТД.РегистрационныйНомер=НовГТД.Код;	
									КонецЕсли;
									ЗаписатьСправочник(НовГТД);
									СообщениеОЗаписи("Создан","Справочник","ГТД",НомерГТД);
									НайденныйГТД=НовГТД.Ссылка
								КонецЕсли;     					
							КонецЕсли;
						КонецЕсли;
						Если Объект.ТипЦен=1 Тогда
							ЦенаБух=0;
							ЗапросЦен=В8.NewObject("Запрос");
							ЗапросЦен.Текст ="ВЫБРАТЬ ПЕРВЫЕ 1
							|	ЦеныНоменклатурыСрезПоследних.Цена
							|ИЗ
							|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
							|			&ДатаСреза,
							|			Номенклатура = &Номенклатура
							|				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних";
							
							ЗапросЦен.УстановитьПараметр("ДатаСреза",ДокПТУ.Дата);
							ЗапросЦен.УстановитьПараметр("Номенклатура",ВыборкаНоменклатура.Номенклатура);
							ЗапросЦен.УстановитьПараметр("ТипЦен",ВидЦеныБУХ);
							
							РезультатЦен = ЗапросЦен.Выполнить();
							ВыборкаЦен= РезультатЦен.Выбрать();
							Если ВыборкаЦен.Следующий() Тогда
								ЦенаБух=ВыборкаЦен.Цена;	 
							КонецЕсли;
							Если ЦенаБух=0 Тогда
								Сообщить("Не установлена бухгалтерская цена у номенклатуры " + НайденаяНом,СтатусСообщения.ОченьВажное);
							КонецЕсли;
							СуммаБух=ЦенаБух*ВыборкаНоменклатура.Количество;
							ПроцентНДС=ПолучитьПроцентПоСтавке(СтавкаНДС);
							Если ДокПТУ.СуммаВключаетНДС Тогда
								НДСБУХ= (ПроцентНДС*СуммаБух/(100+ПроцентНДС)); 
							Иначе
								НДСБУХ=СуммаБух+ПроцентНДС*СуммаБух/100;
							КонецЕсли;
						Иначе
							СуммаБух=ВыборкаНоменклатура.Сумма;
							Если ВыборкаНоменклатура.Количество=0 Тогда
