&НаСервере 
Процедура СоздатьДокументы_сервер()
	
	ЕстьПомеченныеОбъекты=Ложь;
	Для Каждого ЭлСписка Из Объект.СписокОбъектов Цикл
		Если ЭлСписка.Пометка Тогда
			ЕстьПомеченныеОбъекты=Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ  ЕстьПомеченныеОбъекты Тогда
		Сообщить("В списке объектов для переноса ничего не выбрано!");  
		Возврат; 
	КонецЕсли;
	
	ПустойДоговор=Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	ИспользуетсяПП=Ложь;
	Если Объект.ПредварительныйПросмотр.Количество()>0 Тогда
		ИспользуетсяПП=Истина;
	КонецЕсли;	 
	Если Объект.ЗаписыватьСоответствияДокументов и Не ЗначениеЗаполнено(Объект.ВнешняяБаза) Тогда
		Если   Не Метаданные.ПланыОбмена.Найти("УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30")=Неопределено Тогда
			Объект.ВнешняяБаза=ПланыОбмена.УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30.НайтиПоКоду(Объект.ПрефиксИБ);	
		ИначеЕсли  Не Метаданные.ПланыОбмена.Найти("УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30")=Неопределено Тогда 
			Объект.ВнешняяБаза=ПланыОбмена.УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30.НайтиПоКоду(Объект.ПрефиксИБ);	
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ВнешняяБаза) Тогда
			Сообщить("Не найдена внешняя база УТ, проверьте префикс ИБ в настройках",СтатусСообщения.ОченьВажное);
			Возврат; 
		КонецЕсли;
	КонецЕсли;
	В8=Соединение();
	Если В8=Неопределено Тогда
		Сообщить("Не удалось подключиться к БД");
		Возврат;
	КонецЕсли;	
	ПрефиксИБКонстанта=?(ЗначениеЗаполнено(Объект.ПрефиксИсточника),Объект.ПрефиксИсточника,В8.Константы.ПрефиксУзлаРаспределеннойИнформационнойБазы.Получить());
	МассивИНН=В8.NewObject("Массив");
	Для Каждого ЭлСп Из Объект.Организации Цикл
		ОргИзСписка=ЭлСп.Значение;
		Если Не ОргИзСписка.Пустая()  Тогда 
			Если ЗначениеЗаполнено(ОргИзСписка.ИНН) Тогда
				МассивИНН.Добавить(ОргИзСписка.ИНН);
			КонецЕсли;      			 
		КонецЕсли;
	КонецЦикла;  	
	ДатаТек=ТекущаяДата();
	Комм=?(Объект.НеДобавлятьДопКомментарий,"","Перенесён из УТ10 "+ДатаТек);
	Если Объект.ТипЦен=1 Тогда 
		ВидЦеныБУХ=В8.Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию(Объект.ИдентификаторЦены,Истина);
		Если ВидЦеныБУХ.Description="" Тогда
			Сообщить("В УТ10 не найден вид цены и с идентификатором ЗакупочнаяБух",СтатусСообщения.ОченьВажное);
			Возврат;
		КонецЕсли;	  
	КонецЕсли;
	Рубли=Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ЗначениеЗаполнено(Объект.НачПериода) Или Не ЗначениеЗаполнено(Объект.КонПериода)  Тогда 
		Сообщить("Период должен быть заполнен",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;	
	
	ФильтроватьДокументы=Ложь; 
	//СтруктураФильтров=Новый Структура("МассивСкладов,МассивРекв",МассивСкладов,МассивРекв);
	СтруктураФильтров=Новый Структура;
	Если Объект.ПерезаписыватьИзменённыеПланОбмена  Или Объект.ДобавлятьИзменённые  Тогда
		Если ЗначениеЗаполнено(Объект.ИмяПланаОбменаИсточника) Тогда
			ВнешняяБазаПриемника=В8.ПланыОбмена[Объект.ИмяПланаОбменаИсточника].НайтиПоКоду(Объект.ПрефиксИБПриемника);	
		Иначе
