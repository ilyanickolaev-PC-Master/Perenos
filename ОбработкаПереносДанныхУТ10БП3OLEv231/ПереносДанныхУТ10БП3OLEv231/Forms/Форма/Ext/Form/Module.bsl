Функция НайтиСоздатьВидОплытыПоЭквайреру(Эквайрер,ДоговорЭквайринга,Орг,ТипОплаты,НаименованиеВидаОплаты="")
	//Если Найти(Соединение.String(СсылкаУТ),"не найден") = 0 Тогда	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыОплатОрганизаций.Ссылка
	|ИЗ
	|	Справочник.ВидыОплатОрганизаций КАК ВидыОплатОрганизаций
	|ГДЕ
	|	ВидыОплатОрганизаций.Организация = &Организация
	|	И ВидыОплатОрганизаций.Контрагент = &Контрагент
	|	И (ВидыОплатОрганизаций.Наименование = &НаименованиеВидаОплаты Или  Не &ПереноситьНаименованиеВидаОплаты )
	|	И ((ВидыОплатОрганизаций.ДоговорКонтрагента = &ДоговорКонтрагента) Или  &НеУчитыватьДоговорПриПоискеВидаОплат)";
	
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорЭквайринга);
	Запрос.УстановитьПараметр("НеУчитыватьДоговорПриПоискеВидаОплат", Объект.НеУчитыватьДоговорПриПоискеВидаОплат);
	Запрос.УстановитьПараметр("Контрагент", Эквайрер);                
	Запрос.УстановитьПараметр("Организация", Орг);
	Запрос.УстановитьПараметр("НаименованиеВидаОплаты", СокрЛП(НаименованиеВидаОплаты));
	Запрос.УстановитьПараметр("ПереноситьНаименованиеВидаОплаты", Объект.ПереноситьНаименованиеВидаОплаты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат  ВыборкаДетальныеЗаписи.Ссылка
	КонецЕсли;                              
	
	ВидОплаты=Справочники.ВидыОплатОрганизаций.СоздатьЭлемент();
	ВидОплаты.ДоговорКонтрагента=ДоговорЭквайринга;
	ВидОплаты.Контрагент=Эквайрер;              
	ВидОплаты.Организация=Орг;
	ВидОплаты.ТипОплаты=ТипОплаты;                    
	ВидОплаты.Наименование=?(Объект.ПереноситьНаименованиеВидаОплаты,НаименованиеВидаОплаты,Строка(Эквайрер)+" "+Строка(ДоговорЭквайринга));                
	ЗаписатьСправочник(ВидОплаты);
	Возврат ВидОплаты.Ссылка;
КонецФункции
