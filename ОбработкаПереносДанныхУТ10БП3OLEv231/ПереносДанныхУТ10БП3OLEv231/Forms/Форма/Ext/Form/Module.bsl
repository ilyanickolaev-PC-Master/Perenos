			|	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(&ДатаОстатка, ДокументОприходования.Организация.ИНН В (&МассивИНН)) КАК ВводОстатковНоменклатура
			|ИТОГИ
			|	МАКСИМУМ(Склад),
			|	МАКСИМУМ(СсылкаСклад),
			|	МАКСИМУМ(Дата),
			|	Сумма(Сумма),
			|	Сумма(Количество),
			|	МАКСИМУМ(Признак)
			|ПО
			|	ОрганизацияИНН";
			
			
			
			
			
			ХозяйственнаяОперация="";
			УстановитьОбщиеПараметрыЗапроса(Запрос,МассивИНН);		
			Запрос.УстановитьПараметр("ДатаОстатка",КонецДня(Объект.КонПериода));
			Запрос.УстановитьПараметр("МассивИНН",МассивИНН);
			Результат = Запрос.Выполнить();
			
			//ЭлементыФормы.Индикатор1.МинимальноеЗначение=0; 
			ВыборкаДетальныеЗаписи = Результат.Выбрать(В8.ОбходРезультатаЗапроса.ПоГруппировкам,"ОрганизацияИНН");
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Орган=ВыборкаДетальныеЗаписи.ОрганизацияИНН;
				Орг=ПустаяОрг;
				Если НЕ  ЗначениеЗаполнено(Орган) Тогда			
					Продолжить;	
				КонецЕсли;
				Орг=НайтиОрганизацию(Орган);
				Если Не ЗначениеЗаполнено(Орг) Тогда 
					Сообщить("Не найдена организация с ИНН "+ Орган+" документы по ней загружены не будут",СтатусСообщения.ОченьВажное);
					Продолжить;
				КонецЕсли;
				//ВыборкаКонтрагент=ВыборкаДетальныеЗаписи.Выбрать(В8.ОбходРезультатаЗапроса.ПоГруппировкам,"ссылка");
				//Пока ВыборкаВидДокумента.Следующий() Цикл
				
				// ВыборкаКонтрагент=ВыборкаВидДокумента.Выбрать(В8.ОбходРезультатаЗапроса.ПоГруппировкам,"НомерДок");
				//ЭлементыФормы.СтатусИндикатора.Заголовок="Получение счетов документов организации "+Орг.Наименование;
				//ЭлементыФормы.Индикатор1.МаксимальноеЗначение=ВыборкаКонтрагент.Количество();
				
				//Пока ВыборкаКонтрагент.Следующий() Цикл
				ДокументПриёмник=Документы.ВводНачальныхОстатков.СоздатьДокумент();
				ДокПТУ=ДокументПриёмник;
				ДокПТУ.Дата=ВыборкаДетальныеЗаписи.Дата;
				ДокПТУ.Организация=Орг;                              
				
				ДокПТУ.РазделУчета=Перечисления.РазделыУчетаДляВводаОстатков.Товары;
				ДокПТУ.УстановитьНовыйНомер();
				
				ВыборкаНоменклатура=ВыборкаДетальныеЗаписи.Выбрать();
				Пока ВыборкаНоменклатура.Следующий() Цикл
					ВыбНомКод=ВыборкаНоменклатура.НоменклатураКод;
					ВыбНомНаименование=ВыборкаНоменклатура.НоменклатураНаименование;
					ВыбНомНаименованиеПолное=ВыборкаНоменклатура.НомНаименованиеПолное;
					ВыбНомАртикул=ВыборкаНоменклатура.НомАртикул;
					ВыбНом= ВыборкаНоменклатура.Номенклатура;
					НайденыйСклад=НайтиСклад(ВыборкаНоменклатура.СсылкаСклад,ВыборкаНоменклатура.Склад,В8);
					Если НайденыйСклад=Неопределено Тогда
						Если ИспользуетсяПП Тогда
							Для Каждого СтрПП из СтрокаПП Цикл
								СтрПП.Ошибка=Истина;
								Сообщить("Не найден склад "+ВыборкаКонтрагент.Склад+", документы по нему не будут загружены");
							КонецЦикла;        					
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					СтавкаНДС=ПолучитьСтавкуНДС(ВыбНом.СтавкаНДС,В8);
					УИННом=В8.String(ВыбНом.УникальныйИдентификатор());
					шт=НайтиЕдИзм(ВыбНом.ЕдиницаХраненияОстатков);
					//Если Объект.ТоварЭтоХарактеристика и Не ВыборкаНоменклатура.ХарактеристикаНаименование="" и НЕ ВыборкаНоменклатура.ХарактеристикаНаименование=NULL  Тогда УчестьХарактеристику(УИННом,ВыбНомНаименование,ВыбНомНаименованиеПолное,ВыбНом,ВыборкаНоменклатура.ХарактеристикаНаименование,ВыборкаНоменклатура.Характеристика,В8); КонецЕсли;							 
					НайденаяНом= НайтиНоменклатуру(УИННом,ВыбНомНаименование,ВыбНомКод,СтавкаНДС,шт,ВыбНомНаименованиеПолное,ВыбНомАртикул,ВыбНом,В8,,ВыборкаНоменклатура.Услуга);
					Если НайденаяНом=Неопределено Тогда
						Если ИспользуетсяПП Тогда
							Для Каждого СтрПП из СтрокаПП Цикл
								СтрПП.Ошибка=Истина;	
								Сообщить("Не найдена номенклатура "+ВыбНомНаименование);
							КонецЦикла;        					
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					СтрокаПТУ=ДокПТУ.НоменклатураНаСкладе.Добавить();
					СтрокаПТУ.Склад =НайденыйСклад;
					СтрокаПТУ.Номенклатура =НайденаяНом;                       
					СтрокаПТУ.Количество =ВыборкаНоменклатура.Количество;
					Если Объект.ПриПереносеОстаткаВычитатьНДСИЗСтоимости Тогда
						Если ЗначениеЗаполнено(Объект.СтавкаНДСПлатежей) Тогда
							СтНДС=Объект.СтавкаНДСПлатежей;
						Иначе
							СтНДС=СтавкаНДС;
						КонецЕсли;
						Если СтНДС=Перечисления.СтавкиНДС.НДС18 Тогда
							СтрокаПТУ.Сумма =ВыборкаНоменклатура.Сумма/1.18;
						ИначеЕсли  СтНДС=Перечисления.СтавкиНДС.НДС10 Тогда
							СтрокаПТУ.Сумма =ВыборкаНоменклатура.Сумма/1.1;
						ИначеЕсли  СтНДС=Перечисления.СтавкиНДС.НДС20 Тогда
							СтрокаПТУ.Сумма =ВыборкаНоменклатура.Сумма/1.2;
						КонецЕсли;
					Иначе
						СтрокаПТУ.Сумма=ВыборкаНоменклатура.Сумма;
					КонецЕсли;
					СтрокаПТУ.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
					СтрокаПТУ.Партия =Объект.Партия; 
					СтрокаПТУ.СтатусыОплатыРасходовУСН =Объект.СтатусыОплатыРасходовУСН; 
					СтрокаПТУ.СчетУчета=ПланыСчетов.Хозрасчетный.ТоварыНаСкладах;
				КонецЦикла;
				ДокПТУ.Ответственный = Пользователи.ТекущийПользователь();
				ДокПТУ.Комментарий= ?(Объект.ПереноситьКомментарииДокументов,ВыборкаКонтрагент.Ссылка.Комментарий+" "+Комм,Комм);
				ЗаписьУспешна=ЗаписатьПровестиДокумент(Истина,ДокПТУ,Истина,"ВводНачальныхОстатков",ВыборкаКонтрагент,В8,СтруктураФильтров);
			КонецЦикла;
			//КонецЦикла;
			// КонецЦикла;
			Если Объект.СворачиватьТабличныеЧасти Тогда
				ДокПТУ.НоменклатураНаСкладе.Свернуть("Номенклатура,Склад","Количество,Сумма");
				Для Каждого СтрокаТоваров Из ДокПТУ.НоменклатураНаСкладе Цикл
					//Если Объект.ВариантСвёрткиТоваров=0 Тогда
					//	СтрокаТоваров.Количество =1;
					//	СтрокаТоваров.Цена=СтрокаТоваров.Сумма;
					//	//	СтрокаТоваров.ЕдиницаИзмерения =шт;
					//ИначеЕсли СтрокаТоваров.Сумма<>0 Тогда
					//СтрокаТоваров.Количество =1;
					//СтрокаТоваров.Цена=СтрокаТоваров.Сумма/СтрокаТоваров.Количество;
					//	СтрокаТоваров.ЕдиницаИзмерения =шт; 							
					//КонецЕсли;
					
					СтрокаТоваров.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
					СтрокаТоваров.Партия =Объект.Партия; 
					СтрокаТоваров.СтатусыОплатыРасходовУСН =Объект.СтатусыОплатыРасходовУСН; 
					СтрокаТоваров.СчетУчета=ПланыСчетов.Хозрасчетный.ТоварыНаСкладах;
					
				КонецЦикла;
			КонецЕсли;	
			
			
			
		КонецЕсли; // Если ПереноситьВводОстатков_Номенклатура Тогда
		
		
		
		
		
	КонецЕсли;	
	Если Объект.ПомечатьДокументы Тогда
		ПометитьДокументы(В8,МассивИНН);
	КонецЕсли;	
	
	
	
	Если Объект.ТипКоннектора=1 И Не Объект.ДержатьСоединениеОткрытым Тогда
		В8.ЗавершитьРаботуСистемы(Ложь);
		В8=Неопределено;
	ИначеЕсли Не Объект.ДержатьСоединениеОткрытым Тогда
		В8=Неопределено; 
	КонецЕсли;
	
	
	
	
	
КонецПроцедуры


Процедура ПометитьДокументы(В8,МассивИНН)
	Запрос=В8.NewObject("Запрос");
	Запрос.Текст=       "ВЫБРАТЬ
	|	УстановкаЦенНоменклатуры.Ссылка.Номер КАК Номер,
	|	УстановкаЦенНоменклатуры.Ссылка.Дата КАК Дата,
	|	УстановкаЦенНоменклатуры.Ссылка КАК Ссылка,
	|	УстановкаЦенНоменклатуры.ПометкаУдаления,
	|	""Установка цен"" КАК Тип
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	УстановкаЦенНоменклатуры.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И УстановкаЦенНоменклатуры.Проведен = ЛОЖЬ
	|	И &ВыгружатьУстановкуЦен = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка.Номер,
	|	ЗаказПокупателя.Ссылка.Дата,
	|	ЗаказПокупателя.Ссылка,
	|	ЗаказПокупателя.ПометкаУдаления,
	|	""Счёт""
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ЗаказПокупателя.Проведен = ЛОЖЬ
	|	И &ВыгружатьСчета = ИСТИНА
	|	И ЗаказПокупателя.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка.Номер,
	|	РеализацияТоваровУслуг.Ссылка.Дата,
	|	РеализацияТоваровУслуг.Ссылка,
	|	РеализацияТоваровУслуг.ПометкаУдаления,
	|	""РТУ""
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И РеализацияТоваровУслуг.Проведен = ЛОЖЬ
	|	И &ВыгружатьРеализации = ИСТИНА
	|	И РеализацияТоваровУслуг.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратТоваровОтПокупателя.Ссылка.Номер,
	|	ВозвратТоваровОтПокупателя.Ссылка.Дата,
	|	ВозвратТоваровОтПокупателя.Ссылка,
	|	ВозвратТоваровОтПокупателя.ПометкаУдаления,
	|	""Возврат""
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	|ГДЕ
	|	ВозвратТоваровОтПокупателя.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ВозвратТоваровОтПокупателя.Проведен = ЛОЖЬ
	|	И &ВыгружатьВозвраты = ИСТИНА
	|	И ВозвратТоваровОтПокупателя.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка.Номер,
	|	ПриходныйКассовыйОрдер.Ссылка.Дата,
	|	ПриходныйКассовыйОрдер.Ссылка,
	|	ПриходныйКассовыйОрдер.ПометкаУдаления,
	|	""ПКО""
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПриходныйКассовыйОрдер.Проведен = ЛОЖЬ
	|	И &ВыгружатьКассу = ИСТИНА
	|	И ПриходныйКассовыйОрдер.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Ссылка.Номер,
	|	РасходныйКассовыйОрдер.Ссылка.Дата,
	|	РасходныйКассовыйОрдер.Ссылка,
	|	РасходныйКассовыйОрдер.ПометкаУдаления,
	|	""РКО""
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	РасходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И РасходныйКассовыйОрдер.Проведен = ЛОЖЬ
	|	И &ВыгружатьКассу = ИСТИНА
	|	И РасходныйКассовыйОрдер.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПлатежноеПоручениеВходящее.Ссылка.Номер,
	|	ПлатежноеПоручениеВходящее.Ссылка.Дата,
	|	ПлатежноеПоручениеВходящее.Ссылка,
	|	ПлатежноеПоручениеВходящее.ПометкаУдаления,
	|	""ПБДС""
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	ПлатежноеПоручениеВходящее.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПлатежноеПоручениеВходящее.Проведен = ЛОЖЬ
	|	И &ВыгружатьБанк = ИСТИНА
	|	И ПлатежноеПоручениеВходящее.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПлатежноеПоручениеИсходящее.Ссылка.Номер,
	|	ПлатежноеПоручениеИсходящее.Ссылка.Дата,
	|	ПлатежноеПоручениеИсходящее.Ссылка,
	|	ПлатежноеПоручениеИсходящее.ПометкаУдаления,
	|	""СБДС""
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
	|ГДЕ
	|	ПлатежноеПоручениеИсходящее.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПлатежноеПоручениеИсходящее.Проведен = ЛОЖЬ
	|	И &ВыгружатьБанк = ИСТИНА
	|	И ПлатежноеПоручениеИсходящее.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПлатежныйОрдерПоступлениеДенежныхСредств.Ссылка.Номер,
	|	ПлатежныйОрдерПоступлениеДенежныхСредств.Ссылка.Дата,
	|	ПлатежныйОрдерПоступлениеДенежныхСредств.Ссылка,
	|	ПлатежныйОрдерПоступлениеДенежныхСредств.ПометкаУдаления,
	|	""ПОПДС""
	|ИЗ
	|	Документ.ПлатежныйОрдерПоступлениеДенежныхСредств КАК ПлатежныйОрдерПоступлениеДенежныхСредств
	|ГДЕ
	|	ПлатежныйОрдерПоступлениеДенежныхСредств.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПлатежныйОрдерПоступлениеДенежныхСредств.Проведен = ЛОЖЬ
	|	И &ВыгружатьБанк = ИСТИНА
	|	И ПлатежныйОрдерПоступлениеДенежныхСредств.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПлатежныйОрдерСписаниеДенежныхСредств.Ссылка.Номер,
	|	ПлатежныйОрдерСписаниеДенежныхСредств.Ссылка.Дата,
	|	ПлатежныйОрдерСписаниеДенежныхСредств.Ссылка,
	|	ПлатежныйОрдерСписаниеДенежныхСредств.ПометкаУдаления,
	|	""ПОСДС""
	|ИЗ
	|	Документ.ПлатежныйОрдерСписаниеДенежныхСредств КАК ПлатежныйОрдерСписаниеДенежныхСредств
	|ГДЕ
	|	ПлатежныйОрдерСписаниеДенежныхСредств.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПлатежныйОрдерСписаниеДенежныхСредств.Проведен = ЛОЖЬ
	|	И &ВыгружатьБанк = ИСТИНА
