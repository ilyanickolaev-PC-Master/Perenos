Функция НайтиСоздатьБанковскийСчётКонтрагентаПриемник(НомерСчета,ВладелецСчета,БикБанка,КоррСчет,ГородБанка,АдресБанка,ТелефоныБанка,НаименованиеБанка,Валюта,В8)
	СчетОрганизации=В8.Справочники.БанковскиеСчета.НайтиПоРеквизиту("НомерСчета",НомерСчета,,ВладелецСчета);
	Если СчетОрганизации.Пустая() Тогда
		Банк=В8.Справочники.Банки.НайтиПоКоду(БИКБанка); 
		Если Банк.Пустая() Тогда
			БанкОбъект=В8.Справочники.Банки.СоздатьЭлемент();
			БанкОбъект.Код=БИКБанка;
			БанкОбъект.КоррСчет=КоррСчет;                   
			БанкОбъект.Город=ГородБанка;                    
			БанкОбъект.Адрес=АдресБанка;
			БанкОбъект.Телефоны=ТелефоныБанка;
			БанкОбъект.Наименование=НаименованиеБанка;
			ЗаписатьСправочник(БанкОбъект);
			Банк=БанкОбъект.Ссылка;
		КонецЕсли;
		СчётОргОбъект=В8.Справочники.БанковскиеСчета.СоздатьЭлемент();	 
		СчётОргОбъект.НомерСчета=НомерСчета;	 
		СчётОргОбъект.Банк=Банк;	                                    
		СчётОргОбъект.ВалютаДенежныхСредств=Валюта;	  
		// СчётОргОбъект.ВидСчета="Расчетный";
		СчётОргОбъект.Наименование=СчётОргОбъект.НомерСчета;
		СчётОргОбъект.Владелец=ВладелецСчета;
		ЗаписатьСправочник(СчётОргОбъект);
		Возврат СчётОргОбъект.Ссылка;
	КонецЕсли; 
	Возврат  СчетОрганизации;	 
КонецФункции
Функция НайтиСоздатьВалютуПриемник(Валюта,В8)
	ВалютаСсылка=В8.Справочники.Валюты.НайтиПоКоду(Валюта.Код);
	Если  ВалютаСсылка.Пустая() Тогда                                 
		НовВалюта=В8.Справочники.Валюты.СоздатьЭлемент();
		НовВалюта.Наименование= Валюта.Наименование;
		НовВалюта.Код= Валюта.Код;
		НовВалюта.НаименованиеПолное= Валюта.НаименованиеПолное;
		Если ЕстьРеквизитОбъекта("ПараметрыПрописиНаРусском",  В8.Метаданные.Справочники.Валюты) Тогда
			НовВалюта.ПараметрыПрописиНаРусском= Валюта.ПараметрыПрописиНаРусском;
		КонецЕсли;
		Если ЕстьРеквизитОбъекта("ПараметрыПрописи",  В8.Метаданные.Справочники.Валюты) Тогда
			НовВалюта.ПараметрыПрописи= Валюта.ПараметрыПрописи;
		КонецЕсли;                                               
		ЗаписатьСправочник(НовВалюта);
		ВалютаСсылка=НовВалюта.Ссылка;	
