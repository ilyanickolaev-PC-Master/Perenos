КонецПроцедуры

&НаКлиенте
Процедура ВариантВыгрузкиНоменклатурыПриИзменении(Элемент)
	ВидимостьНоменклатуры=Объект.ВариантВыгрузкиНоменклатуры=0 Или Объект.ВариантВыгрузкиНоменклатуры=2  Или Объект.ВариантВыгрузкиНоменклатуры=3;
	ЭтаФорма.Элементы.Закладки.ПодчиненныеЭлементы.Номенклатура.Видимость=Не ВидимостьНоменклатуры;
	ЭтаФорма.Элементы.Закладки.ПодчиненныеЭлементы.Номенклатура.Доступность=Не ВидимостьНоменклатуры;
	Если Объект.ВариантВыгрузкиНоменклатуры=1 И ТЗКонтрагентов.Количество()>0 Тогда
		Ответ = Вопрос("Перечитать данные из УТ10?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Если  Ответ = КодВозвратаДиалога.Да Тогда
			ПолучитьДанные("");	
		КонецЕсли;	
	КонецЕсли; 
	ПроверитьГотовностьНоменклатуры();
	//ПроверитьГотовностьНоменклатуры();  
	Элементы.ГотовностьНоменклатуры.Видимость=НЕ ВидимостьНоменклатуры;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьЭлементыФормы(); 
	ВидимостьНоменклатуры=?(Объект.ВариантВыгрузкиНоменклатуры=1,Истина,Ложь);
	//Заплатка
	Если Объект.ВариантВыгрузкиСкладов=0 Тогда
		Объект.ВариантВыгрузкиСкладов=2;
	КонецЕсли; 	
	ВидимостьСкладов=?(Объект.ВариантВыгрузкиСкладов=1,Истина,Ложь);
	ВидимостьСтатей=?(Объект.ВариантВыгрузкиСтатейДДС=1,Истина,Ложь);
	
	Элементы.Закладки.ПодчиненныеЭлементы.Номенклатура.Видимость=ВидимостьНоменклатуры;
	Элементы.Закладки.ПодчиненныеЭлементы.Номенклатура.Доступность=ВидимостьНоменклатуры;
	Элементы.ГотовностьНоменклатуры.Видимость=ВидимостьНоменклатуры;
	Элементы.Закладки.ПодчиненныеЭлементы.Склады.Видимость=ВидимостьСкладов;
	Элементы.Закладки.ПодчиненныеЭлементы.Склады.Доступность=ВидимостьСкладов;
	Элементы.ГотовностьСкладов.Видимость=ВидимостьСкладов;
	Элементы.КнСоздатьДокументы.Доступность=ложь;
	Элементы.КнПредварительныйПросмотр.Доступность=ложь;
	Элементы.Закладки.ПодчиненныеЭлементы.СтраницаПредварительныйПросмотр.Видимость=ложь;
	Элементы.Закладки.ПодчиненныеЭлементы.СтатьиДДС.Видимость=ВидимостьСтатей;
	Элементы.Закладки.ПодчиненныеЭлементы.СтатьиДДС.Доступность=ВидимостьСтатей;
	Элементы.ГотовностьСтатейДДС.Видимость=ВидимостьСтатей;  	
	//По умолчанию откроем на закладке с настройками
	Элементы.Закладки.ТекущаяСтраница=Элементы.Закладки.ПодчиненныеЭлементы.Настройки;
	ОбновитьСпискиНастроек();
КонецПроцедуры

&НаКлиенте
Процедура Готовность(Команда) 
	ПроверитьГотовностьКонтрагентов();	
	Элементы.Закладки.ТекущаяСтраница=Элементы.Закладки.ПодчиненныеЭлементы.Контрагенты; 	
КонецПроцедуры

&НаКлиенте  
Процедура ПроверитьГотовностьНоменклатуры(НоменклатураГотова=Истина)
	Если Не ТЗНоменклатуры.Количество()>0 И НЕ ЗначениеЗаполнено(Объект.НоменклатураЗамены)  Тогда 
		ЭтаФорма.НоменклатураПроверена=Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.ВариантВыгрузкиНоменклатуры=0 или Объект.ВариантВыгрузкиНоменклатуры=2 или Объект.ВариантВыгрузкиНоменклатуры=3 или Объект.ВариантВыгрузкиНоменклатуры=4 Тогда 
		Элементы.ГотовностьНоменклатуры.Картинка=Элементы.ЗелёнаяГалка.Картинка;
		ЭтаФорма.НоменклатураПроверена=Истина;
		Если ?(Объект.ВариантВыгрузкиСкладов=0 или Объект.ВариантВыгрузкиСкладов=2,Истина,ЭтаФорма.СкладыПроверены) И ЭтаФорма.КонтрагентыПроверены Тогда
			Элементы.КнСоздатьДокументы.Доступность=Истина;
			Элементы.КнПредварительныйПросмотр.Доступность=Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;  
	
	Если Объект.ВариантВыгрузкиНоменклатуры=1 И ЗначениеЗаполнено(Объект.НоменклатураЗамены) Тогда
		Элементы.ГотовностьНоменклатуры.Картинка=Элементы.ЗелёнаяГалка.Картинка;     
		ЭтаФорма.НоменклатураПроверена=Истина;
		
		Если ?(Объект.ВариантВыгрузкиСкладов=0 или Объект.ВариантВыгрузкиСкладов=2,Истина,ЭтаФорма.СкладыПроверены) И ЭтаФорма.КонтрагентыПроверены Тогда
			Элементы.КнСоздатьДокументы.Доступность=Истина;
			Элементы.КнПредварительныйПросмотр.Доступность=Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Не НоменклатураГотова Тогда
		Элементы.ГотовностьНоменклатуры.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;
		
		ЭтаФорма.НоменклатураПроверена=ЛОЖЬ;
		Возврат;
	КонецЕсли;
	СтруктураПоиска=Новый Структура("Номенклатура");
	СтруктураПоиска.Номенклатура=ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
	Если Не ТЗНоменклатуры.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
		Элементы.ГотовностьНоменклатуры.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;
		ЭтаФорма.НоменклатураПроверена=ЛОЖЬ;
		Возврат;
	КонецЕсли;
	Элементы.ГотовностьНоменклатуры.Картинка=Элементы.ЗелёнаяГалка.Картинка;
	ЭтаФорма.НоменклатураПроверена=Истина;
	Если ?(Объект.ВариантВыгрузкиСкладов=0 или Объект.ВариантВыгрузкиСкладов=2,Истина,ЭтаФорма.СкладыПроверены) И ЭтаФорма.КонтрагентыПроверены И  ?(Объект.ВариантВыгрузкиСтатейДДС=0 или Объект.ВариантВыгрузкиСтатейДДС=2,Истина,ЭтаФорма.СтатьиПроверены)Тогда
		Элементы.КнСоздатьДокументы.Доступность=Истина;
		Элементы.КнПредварительныйПросмотр.Доступность=Истина;
	КонецЕсли;
	////Если КонтрагентыПроверены И СкладыПроверены Тогда
	////	ЭлементыФормы.ОсновныеДействияФормы.Кнопки.СоздатьДокументы.Доступность=Истина;
	////КонецЕсли;
КонецПроцедуры



&НаКлиенте
Процедура ПроверитьГотовностьКонтрагентов(КонтрагентыГотовы=Истина)
	Если Не ТЗКонтрагентов.Количество()>0  Тогда 
		Элементы.ГотовностьКонтрагентов.Картинка=Элементы.ЗелёнаяГалка.Картинка;
		ЭтаФорма.КонтрагентыПроверены=Истина;
		Возврат;
	КонецЕсли;
	Если Не КонтрагентыГотовы Тогда
		Элементы.ГотовностьКонтрагентов.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;   
		ЭтаФорма.КонтрагентыПроверены=ЛОЖЬ;
		Возврат;
	КонецЕсли;
	
	СтруктураПоиска=Новый Структура("Контрагент");
	СтруктураПоиска.Контрагент=ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	Если Не ТЗКонтрагентов.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
		Элементы.ГотовностьКонтрагентов.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;   
		ЭтаФорма.КонтрагентыПроверены=ЛОЖЬ;
		Возврат;
	КонецЕсли;
	Если   Объект.ДокументыВРазрезеДоговоров Тогда
		Элементы.ГотовностьКонтрагентов.Картинка=Элементы.ЗелёнаяГалка.Картинка;
		ЭтаФорма.КонтрагентыПроверены=Истина; 	
		Если ?(Объект.ВариантВыгрузкиНоменклатуры=0 или Объект.ВариантВыгрузкиНоменклатуры=2 Или Объект.ВариантВыгрузкиНоменклатуры=3  или Объект.ВариантВыгрузкиНоменклатуры=4,Истина,ЭтаФорма.НоменклатураПроверена) И ?(Объект.ВариантВыгрузкиСкладов=0 или Объект.ВариантВыгрузкиСкладов=2,Истина,ЭтаФорма.СкладыПроверены) И  ?(Объект.ВариантВыгрузкиСтатейДДС=0 или Объект.ВариантВыгрузкиСтатейДДС=2,Истина,ЭтаФорма.СтатьиПроверены) Тогда
			Элементы.КнСоздатьДокументы.Доступность=Истина;
			Элементы.КнПредварительныйПросмотр.Доступность=Истина;
		КонецЕсли;
		Возврат; 
	КонецЕсли;
	
	
	СтруктураПоиска=Новый Структура("Договор,ДоговорНеНужен");
	СтруктураПоиска.Договор=ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	СтруктураПоиска.ДоговорНеНужен=Ложь;
	Если Не ТЗКонтрагентов.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
		Элементы.ГотовностьКонтрагентов.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;   
		ЭтаФорма.КонтрагентыПроверены=ЛОЖЬ;
		Возврат;
	КонецЕсли;   
	Элементы.ГотовностьКонтрагентов.Картинка=Элементы.ЗелёнаяГалка.Картинка;
	ЭтаФорма.КонтрагентыПроверены=Истина; 	
	Если ?(Объект.ВариантВыгрузкиНоменклатуры=0 или Объект.ВариантВыгрузкиНоменклатуры=2 Или Объект.ВариантВыгрузкиНоменклатуры=3  или Объект.ВариантВыгрузкиНоменклатуры=4,Истина,ЭтаФорма.НоменклатураПроверена) И ?(Объект.ВариантВыгрузкиСкладов=0 или Объект.ВариантВыгрузкиСкладов=2,Истина,ЭтаФорма.СкладыПроверены) И  ?(Объект.ВариантВыгрузкиСтатейДДС=0 или Объект.ВариантВыгрузкиСтатейДДС=2,Истина,ЭтаФорма.СтатьиПроверены) Тогда
		Элементы.КнСоздатьДокументы.Доступность=Истина;
		Элементы.КнПредварительныйПросмотр.Доступность=Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте	
Процедура ПроверитьГотовностьСкладов(СкладыГотовы=Истина)
	Если ЗначениеЗаполнено(Объект.СкладЗамены) Тогда
		Элементы.ГотовностьСкладов.Картинка=Элементы.ЗелёнаяГалка.Картинка;
		ЭтаФорма.СкладыПроверены=Истина;
		Возврат;
	КонецЕсли;
	
	Если Не ТЗСкладов.Количество()>0  Тогда
		ЭтаФорма.СкладыПроверены=Истина;
		Возврат;
	КонецЕсли;  
	Если Объект.ВариантВыгрузкиСкладов=0 Или Объект.ВариантВыгрузкиСкладов=2 Тогда 
		Элементы.ГотовностьСкладов.Картинка=Элементы.ЗелёнаяГалка.Картинка;
		ЭтаФорма.СкладыПроверены=Истина;
		Возврат;
	КонецЕсли;    	 
	Если Не СкладыГотовы Тогда
		Элементы.ГотовностьСкладов.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;   
		ЭтаФорма.СкладыПроверены=ЛОЖЬ;
		Возврат;
	КонецЕсли;
	СтруктураПоиска=Новый Структура("Склад");
	СтруктураПоиска.Склад=ПредопределенноеЗначение("Справочник.Склады.ПустаяСсылка");
	Если Не ТЗСкладов.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
		Элементы.ГотовностьСкладов.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;   
		ЭтаФорма.СкладыПроверены=ЛОЖЬ;  
		Возврат;
	КонецЕсли;	 
	Элементы.ГотовностьСкладов.Картинка=Элементы.ЗелёнаяГалка.Картинка;
	ЭтаФорма.СкладыПроверены=Истина;		 
