	|ГДЕ
	|	ПоступлениеТоваровУслуг.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПоступлениеТоваровУслуг.Проведен = ЛОЖЬ
	|	И &ВыгружатьПоступления = ИСТИНА
	|	И ПоступлениеТоваровУслуг.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТребованиеНакладная.Ссылка.Номер,
	|	ТребованиеНакладная.Ссылка.Дата,
	|	ТребованиеНакладная.Ссылка,
	|	ТребованиеНакладная.ПометкаУдаления,
	|	""ТН""
	|ИЗ
	|	Документ.ТребованиеНакладная КАК ТребованиеНакладная
	|ГДЕ
	|	ТребованиеНакладная.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ТребованиеНакладная.Проведен = ЛОЖЬ
	|	И &ВыгружатьТребованияНакладные = ИСТИНА
	|	И ТребованиеНакладная.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПеремещениеТоваров.Ссылка.Номер,
	|	ПеремещениеТоваров.Ссылка.Дата,
	|	ПеремещениеТоваров.Ссылка,
	|	ПеремещениеТоваров.ПометкаУдаления,
	|	""Перем""
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ПеремещениеТоваров.Проведен = ЛОЖЬ
	|	И &ВыгружатьПеремещенияТоваров = ИСТИНА
	|	И ПеремещениеТоваров.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОприходованиеТоваров.Ссылка.Номер,
	|	ОприходованиеТоваров.Ссылка.Дата,
	|	ОприходованиеТоваров.Ссылка,
	|	ОприходованиеТоваров.ПометкаУдаления,
	|	""Оприх""
	|ИЗ
	|	Документ.ОприходованиеТоваров КАК ОприходованиеТоваров
	|ГДЕ
	|	ОприходованиеТоваров.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ОприходованиеТоваров.Проведен = ЛОЖЬ
	|	И &ВыгружатьСкладскиеАкты = ИСТИНА
	|	И ОприходованиеТоваров.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СписаниеТоваров.Ссылка.Номер,
	|	СписаниеТоваров.Ссылка.Дата,
	|	СписаниеТоваров.Ссылка,
	|	СписаниеТоваров.ПометкаУдаления,
	|	""Спис""
	|ИЗ
	|	Документ.СписаниеТоваров КАК СписаниеТоваров
	|ГДЕ
	|	СписаниеТоваров.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И СписаниеТоваров.Проведен = ЛОЖЬ
	|	И &ВыгружатьСкладскиеАкты = ИСТИНА
	|	И СписаниеТоваров.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтчетОРозничныхПродажах.Ссылка.Номер,
	|	ОтчетОРозничныхПродажах.Ссылка.Дата,
	|	ОтчетОРозничныхПродажах.Ссылка,
	|	ОтчетОРозничныхПродажах.ПометкаУдаления,
	|	""ОРП""
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах КАК ОтчетОРозничныхПродажах
	|ГДЕ
	|	ОтчетОРозничныхПродажах.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ОтчетОРозничныхПродажах.Проведен = ЛОЖЬ
	|	И &ВыгружатьРозничныеПродажи = ИСТИНА
	|	И ОтчетОРозничныхПродажах.Организация.ИНН В(&МассивИНН)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратТоваровПоставщику.Ссылка.Номер,
	|	ВозвратТоваровПоставщику.Ссылка.Дата,
	|	ВозвратТоваровПоставщику.Ссылка,
	|	ВозвратТоваровПоставщику.ПометкаУдаления,
	|	""Возврат поставщику""
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику КАК ВозвратТоваровПоставщику
	|ГДЕ
	|	ВозвратТоваровПоставщику.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|	И ВозвратТоваровПоставщику.Проведен = ЛОЖЬ
	|	И &ВыгружатьВозвратыПоставщику = ИСТИНА
	|	И ВозвратТоваровПоставщику.Организация.ИНН В(&МассивИНН)";
	
	Запрос.УстановитьПараметр("ВыгружатьПоступления",Объект.ВыгружатьПоступления); 
	Запрос.УстановитьПараметр("ВыгружатьРеализации",Объект.ВыгружатьРеализации); 
	Запрос.УстановитьПараметр("ВыгружатьВозвраты",Объект.ВыгружатьВозвраты); 
	Запрос.УстановитьПараметр("ВыгружатьКассу",Объект.ВыгружатьКассу); 
	Запрос.УстановитьПараметр("ВыгружатьБанк",Объект.ВыгружатьБанк); 
	Запрос.УстановитьПараметр("ВыгружатьСчета",Объект.ВыгружатьСчета); 
	Запрос.УстановитьПараметр("ДатаНач",Объект.НачПериода);
	Запрос.УстановитьПараметр("ДатаКон",КонецДня(Объект.КонПериода));
	Запрос.УстановитьПараметр("МассивИНН",МассивИНН);
	Запрос.УстановитьПараметр("ВыгружатьАвансовыеОтчеты",Объект.ВыгружатьАвансовыеОтчеты); 
	Запрос.УстановитьПараметр("ТолькоДокуменыСпризнакомБУ",Объект.ТолькоДокуменыСпризнакомБУ); 
	Запрос.УстановитьПараметр("ВыгружатьРозничныеПродажи",Объект.ВыгружатьРозничныеПродажи); 
	Запрос.УстановитьПараметр("ВыгружатьВозвратыПоставщику",Объект.ВыгружатьВозвратыПоставщику); 
	Запрос.УстановитьПараметр("ВыгружатьОплатуКартами",Объект.ВыгружатьОплатуКартами);
	Запрос.УстановитьПараметр("ВыгружатьПеремещенияТоваров",Объект.ВыгружатьПеремещенияТоваров);
	Запрос.УстановитьПараметр("ВыгружатьСкладскиеАкты",Объект.ВыгружатьСкладскиеАкты);
	Запрос.УстановитьПараметр("ВыгружатьТребованияНакладные",Объект.ВыгружатьТребованияНакладные);
	Запрос.УстановитьПараметр("ВыгружатьУстановкуЦен",Объект.ВыгружатьУстановкуЦен);
	
	
	Результат = Запрос.Выполнить();
	ВыборкаДокумент = Результат.Выбрать();
	Пока ВыборкаДокумент.Следующий() Цикл
		УИНДок = В8.String(ВыборкаДокумент.Ссылка.УникальныйИдентификатор());
		
		
		Если Объект.ЗаписыватьСоответствияДокументов  И Не Объект.ПривязкаНеДляПоискаДокументов Тогда
			ДокументСсылка=ПолучитьОбъектИзID(УИНДок, Объект.ВнешняяБаза);
			Если ДокументСсылка=Неопределено Тогда
				Продолжить; 
			КонецЕсли; 
		Иначе 
			НомерДокПП=ВыборкаДокумент.Номер;
			ДатаДокПП=ВыборкаДокумент.Дата;
			Если ВыборкаДокумент.Тип="ПТУ" Тогда 
				ДокументСсылка=Документы.ПоступлениеТоваровУслуг.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="Перем" Тогда 
				ДокументСсылка=Документы.ПеремещениеТоваров.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="РТУ" Тогда 
				ДокументСсылка=Документы.РеализацияТоваровУслуг.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ПКО" Тогда 
				ДокументСсылка=Документы.ПриходныйКассовыйОрдер.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="РКО" Тогда 
				ДокументСсылка=Документы.РасходныйКассовыйОрдер.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="Возврат" Тогда 
				ДокументСсылка=Документы.ВозвратТоваровОтПокупателя.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ПБДС" Тогда 
				ДокументСсылка=Документы.ПоступлениеНаРасчетныйСчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="СБДС" Тогда 
				ДокументСсылка=Документы.СписаниеСРасчетногоСчета.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ПОПДС" Тогда 
				ДокументСсылка=Документы.ПоступлениеНаРасчетныйСчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ПОСДС" Тогда 
				ДокументСсылка=Документы.СписаниеСРасчетногоСчета.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ИППер" Тогда 
				ДокументСсылка=Документы.ПоступлениеНаРасчетныйСчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ИППол" Тогда 
				ДокументСсылка=Документы.СписаниеСРасчетногоСчета.НайтиПоНомеру(НомерДокПП,ДатаДокПП);  				 
			ИначеЕсли ВыборкаДокумент.Тип="Счёт" Тогда 
				ДокументСсылка=Документы.СчетНаОплатуПокупателю.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="АО" Тогда 
				ДокументСсылка=Документы.АвансовыйОтчет.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="Возврат поставщику" Тогда 
				ДокументСсылка=Документы.ВозвратТоваровПоставщику.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ОРП" Тогда 
				ДокументСсылка=Документы.ОтчетОРозничныхПродажах.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="ТН" Тогда 
				ДокументСсылка=Документы.ТребованиеНакладная.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="Спис" Тогда 
				ДокументСсылка=Документы.СписаниеТоваров.НайтиПоНомеру(НомерДокПП,ДатаДокПП);
			ИначеЕсли ВыборкаДокумент.Тип="Оприх" Тогда 
				ДокументСсылка=Документы.ОприходованиеТоваров.НайтиПоНомеру(НомерДокПП,ДатаДокПП);	 
			ИначеЕсли ВыборкаДокумент.Тип="Установка цен" Тогда 
				ДокументСсылка=Документы.УстановкаЦенНоменклатуры.НайтиПоНомеру(НомерДокПП,ДатаДокПП);	 
			КонецЕсли;
			Если ДокументСсылка.Пустая() Тогда
				Продолжить; 
			КонецЕсли; 						 
		КонецЕсли;
		ПомеченНаУдаление=Ложь;	
		ДокОбъект= ДокументСсылка.ПолучитьОбъект();
		Если  ДокументСсылка.Проведен Тогда
			Если ДокОбъект.ПометкаУдаления<>ВыборкаДокумент.ПометкаУдаления Тогда
				ДокОбъект.ПометкаУдаления=ВыборкаДокумент.ПометкаУдаления; 
				ПомеченНаУдаление=Истина;	
			КонецЕсли;
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			СообщениеОЗаписи(?(ПомеченНаУдаление,"Помечен на удаление","Отменено проведение"),"документ",ВыборкаДокумент.Тип,НомерДокПП);
		Иначе
			Если ДокОбъект.ПометкаУдаления<>ВыборкаДокумент.ПометкаУдаления Тогда
				ДокОбъект.ПометкаУдаления=ВыборкаДокумент.ПометкаУдаления; 							
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				СообщениеОЗаписи("Помечен на удаление","документ",ВыборкаДокумент.Тип,НомерДокПП);
			КонецЕсли;      
		КонецЕсли;	   				 
	КонецЦикла;
КонецПроцедуры

Функция ЕстьРеквизитТабЧастиДокумента(ИмяРеквизита, МетаданныеДокумента, ИмяТабЧасти) Экспорт
	
	ТабЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабЧасти);
	
	Если ТабЧасть = Неопределено Тогда // Нет такой таб. части в документе
		Возврат Ложь;
		
	Иначе
		Возврат НЕ (ТабЧасть.Реквизиты.Найти(ИмяРеквизита) = Неопределено);
		
	КонецЕсли;
	
КонецФункции // ЕстьРеквизитТабЧастиДокумента()
Функция СформироватьТекстЗапросаРозничныеПродажи(Запрос,В8)
	ТекстЗапроса =     "ВЫБРАТЬ
|	ОтчетОРозничныхПродажахТовары.Ссылка.Организация.ИНН КАК ОрганизацияИНН,
|	ОтчетОРозничныхПродажахТовары.Ссылка.Номер КАК НомерДок,
|	ОтчетОРозничныхПродажахТовары.Ссылка.СуммаВключаетНДС КАК НДСвключатьВСтоимость,
|	ОтчетОРозничныхПродажахТовары.Ссылка.СуммаДокумента КАК СуммаДокументаВсего,
|	ОтчетОРозничныхПродажахТовары.Ссылка.Склад.Наименование КАК Склад,
|	ОтчетОРозничныхПродажахТовары.Ссылка.Склад КАК СсылкаСклад,
|	ОтчетОРозничныхПродажахТовары.Ссылка.Проведен КАК Проведен,
|	ОтчетОРозничныхПродажахТовары.Номенклатура.Код КАК НоменклатураКод,
|	ОтчетОРозничныхПродажахТовары.Номенклатура КАК Номенклатура,
