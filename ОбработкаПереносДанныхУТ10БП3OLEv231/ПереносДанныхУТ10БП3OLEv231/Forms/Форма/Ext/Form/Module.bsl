		Результат = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать(В8.ОбходРезультатаЗапроса.ПоГруппировкам,"ОрганизацияИНН");
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Орган=ВыборкаДетальныеЗаписи.ОрганизацияИНН;
			Орг=ПустаяОрг;
			Если НЕ  ЗначениеЗаполнено(Орган) Тогда			
				Продолжить;	
			КонецЕсли;
			Орг=НайтиОрганизацию(Орган);
			Если Не ЗначениеЗаполнено(Орг) Тогда 
				Сообщить("Не найдена организация с ИНН "+ Орган+" документы по ней загружены не будут",СтатусСообщения.ОченьВажное);
				Продолжить;
			КонецЕсли;
			ВыборкаКонтрагент=ВыборкаДетальныеЗаписи.Выбрать(В8.ОбходРезультатаЗапроса.ПоГруппировкам,);
			Пока ВыборкаКонтрагент.Следующий() Цикл
				Если ФильтроватьДокументы Тогда
					Если Не ДокументПрошёлФильтр(ВыборкаКонтрагент.Ссылка,СтруктураФильтров,В8) Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли; 
				ВыбКонтр=ВыборкаКонтрагент.Контрагент;
				ВыбКонтрИНН=ВыборкаКонтрагент.КонтрагентИНН;
				УИН=В8.String(ВыбКонтр.УникальныйИдентификатор());
				СтруктураПоиска=Новый Структура("УИН,Организация,Операция,Валюта");
				СтруктураПоиска.УИН =УИН;
				СтруктураПоиска.Организация =Орг;
				Валюта=НайтиСоздатьВалюту(ВыборкаКонтрагент.Ссылка.ВалютаДокумента);
				СтруктураПоиска.Валюта =Валюта;
				
				СтруктураПоиска.Операция=ВыборкаКонтрагент.Признак;
				СтрокиКонтр=ТЗКонтрагентов.НайтиСтроки(СтруктураПоиска);
				УИНДок = В8.String(ВыборкаКонтрагент.Ссылка.УникальныйИдентификатор());
				
				Если Объект.ЗаписыватьСоответствияДокументов И Не Объект.ПривязкаНеДляПоискаДокументов Тогда
					ДокументСсылкаПриёмник=ПолучитьОбъектИзID(УИНДок, Объект.ВнешняяБаза);
					Если Не ДокументСсылкаПриёмник = Неопределено И Не Объект.ПерезаписыватьВыгруженныеДокументы Тогда
						Статус="Будет пропущен";
					КонецЕсли;
					Если ДокументСсылкаПриёмник = Неопределено Тогда
						Статус="Будет создан";
					Иначе
						Статус="Будет перезаписан";
					КонецЕсли;
				Иначе
					Если Объект.Нумерация=0 Тогда
						ДокументСсылкаПриёмник=Документы.КорректировкаПоступления.НайтиПоНомеру(ВыборкаКонтрагент.НомерДок,ВыборкаКонтрагент.Дата); 
						Если Не ДокументСсылкаПриёмник.Пустая() И Не Объект.ПерезаписыватьВыгруженныеДокументы Тогда
							Статус="Будет пропущен"; 
						ИначеЕсли Не ДокументСсылкаПриёмник.Пустая() Тогда
							Статус="Будет перезаписан";  
						Иначе
							Статус="Будет создан";
						КонецЕсли;   					  
					Иначе
						Статус="Будет создан";
					КонецЕсли;
				КонецЕсли;
				
				
				Если СтрокиКонтр.Количество()=0 Тогда
					Сообщить("Обработка: "+ВыборкаКонтрагент.Тип+?(ВыбКонтр.Наименование=""," Не указан контрагент "," Не найден контрагент ")+ВыбКонтр.Наименование+", документ "+ВыборкаКонтрагент.НомерДок+ " не будет загружен");
					Продолжить;
				КонецЕсли;
				СтрКонтрагент=СтрокиКонтр[0];
				Контр=СтрКонтрагент.Контрагент;
				Если Не Значениезаполнено(Контр) Тогда
					Сообщить("Обработка: "+ВыборкаКонтрагент.Тип+?(ВыбКонтр.Наименование=""," Не указан контрагент "," Не найден контрагент ")+ВыбКонтр.Наименование+", документ "+ВыборкаКонтрагент.НомерДок+ " не будет загружен");
					Продолжить;
				КонецЕсли;
				
				Если Объект.ДокументыВРазрезеДоговоров и Не СтрКонтрагент.ДоговорНеНужен Тогда
					ДогВ8=ВыборкаКонтрагент.Ссылка.ДоговорКонтрагента; 
					Если Не СокрЛП(ДогВ8.Наименование) ="" Тогда     
						Договор=НайтиДоговорКонтрагента(Контр,ДогВ8.Наименование,ДогВ8.Номер,ДогВ8.Дата,ДогВ8.СрокДействия,Валюта,Орг,ДогВ8.ВидДоговора,В8,ДогВ8);	 
					Иначе
						Договор=СтрКонтрагент.Договор;
						Если Не Значениезаполнено(Договор) Тогда
							Сообщить("Не найден договор контрагента "+ВыбКонтр.Наименование+", документы по нему не будут загружены");
							Продолжить;
						КонецЕсли;  
					КонецЕсли; 
				Иначе     					 
					Договор=СтрКонтрагент.Договор;
					Если Не Значениезаполнено(Договор) и Не СтрКонтрагент.ДоговорНеНужен Тогда
						Сообщить("Не найден договор контрагента "+ВыбКонтр.Наименование+", документы по нему не будут загружены");
						Продолжить;
					КонецЕсли;                             
				КонецЕсли; 
				
				СкладТЧ="";
				НаимСклад=ВыборкаКонтрагент.СсылкаСклад.Наименование;    
				НайденыйСклад=НайтиСклад(ВыборкаКонтрагент.СсылкаСклад,НаимСклад,В8);
				Если НайденыйСклад=Неопределено Тогда
					Сообщить("Не найден Склад  "+НаимСклад);
					Продолжить;
				КонецЕсли; 
				
				Если  НайденыйСклад.Пустая() Тогда
					СкладТЧ="Будет создан "+НаимСклад;
				Иначе
					СкладТЧ=НайденыйСклад.Наименование;
				КонецЕсли;
				СтрокаПревю=Объект.ПредварительныйПросмотр.Добавить();
				СтрокаПревю.Тип=ВыборкаКонтрагент.Тип;
				СтрокаПревю.Загружать=Истина;
				СтрокаПревю.Контрагент=Контр;
				СтрокаПревю.Договор=Договор;
				СтрокаПревю.Дата=ВыборкаКонтрагент.Дата;
				СтрокаПревю.Номер=ВыборкаКонтрагент.НомерДок;
				СтрокаПревю.Организация=Орг;
				СтрокаПревю.Сумма=ВыборкаКонтрагент.СуммаДокумента;
				СтрокаПревю.Склад=СкладТЧ;
				СтрокаПревю.Статус=Статус;
				СтрокаПревю.СчФактура=ВыборкаКонтрагент.ЕстьСФ;
				СтрокаПревю.ХозяйственнаяОперация=В8.XMLString(ВыборкаКонтрагент.ХозяйственнаяОперация);
				СтрокаПревю.УИН=УИНДок;
				
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;  //Если ВыгружатьКорректировкиПоступлений Тогда
	
	
	Если Объект.ТипКоннектора=1 И Не Объект.ДержатьСоединениеОткрытым Тогда
		В8.ЗавершитьРаботуСистемы(Ложь);
		В8=Неопределено;
	ИначеЕсли Не Объект.ДержатьСоединениеОткрытым Тогда
		В8=Неопределено; 
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция НайтиСклад(СсылкаСклад,Наименование,В8)
	//Нет кода у справочника "Склады" в УТ11
	
	//Если Объект.ВариантВыгрузкиСкладов=0 Тогда
	//		 
	//	//// ВыбСклад=ВыборкаКонтрагент.Склад;
	//	////НайденыйСклад=Справочники.Склады.НайтиПоКоду(СсылкаСклад.Код);
	//	////Если  НайденыйСклад.Пустая() Тогда
	//	////	НовСклад=Справочники.Склады.СоздатьЭлемент();
	//	////	НовСклад.Код=СсылкаСклад.Код;
	//	////	НовСклад.Наименование=Наименование;
	//	////	НовСклад.ТипСклада=Перечисления.ТипыСкладов.ОптовыйСклад;
	//	////	ЗаписатьСправочник(НовСклад);    
	//	////	Сообщить("Создан Склад  "+Наименование); 
	//	////	Возврат НовСклад.Ссылка;
	//	////Иначе
	//	////	Возврат НайденыйСклад;
	//	////КонецЕсли;
	
	Если Объект.ВариантВыгрузкиСкладов=1 Тогда
		Если ЗначениеЗаполнено(Объект.СкладЗамены) Тогда
			Возврат  Объект.СкладЗамены;
		КонецЕсли;
		УИНСклад=В8.String(СсылкаСклад.УникальныйИдентификатор());
		СтруктураПоиска=Новый Структура("УИН");
		СтруктураПоиска.Уин=УИНСклад;
		СтрокаСклад=ТЗСкладов.НайтиСтроки(СтруктураПоиска);
		Если Не СтрокаСклад.Количество()>0 Тогда
			Сообщить("Не найден Склад  "+Наименование);
			//		 ЭлементыФормы.Индикатор1.Значение=ЭлементыФормы.Индикатор1.Значение+1;		 
			Возврат Неопределено;
		КонецЕсли;
		Скл=СтрокаСклад[0].Склад;
		Если Не Значениезаполнено(Скл) Тогда
			Сообщить("Не найден Склад  "+Наименование);
			//		 ЭлементыФормы.Индикатор1.Значение=ЭлементыФормы.Индикатор1.Значение+1;		 
			Возврат Неопределено;
		КонецЕсли; 
		Возврат Скл;  		  
	Иначе
		НайденыйСклад=Справочники.Склады.НайтиПоНаименованию(Наименование,Истина);
		Если  НайденыйСклад.Пустая() Тогда
			НовСклад=Справочники.Склады.СоздатьЭлемент();
			НовСклад.УстановитьНовыйКод();
			НовСклад.Наименование=Наименование;
			НовСклад.ТипСклада=ПолучитьТипСклада(СсылкаСклад,В8);  
			ЗаписатьСправочник(НовСклад);
			Возврат НовСклад.Ссылка;
		Иначе
			Возврат НайденыйСклад;
		КонецЕсли; 	
	КонецЕсли;	
КонецФункции


Функция ПолучитьТипСклада(СсылкаСклад,В8)
	ТипСклада=Перечисления.ТипыСкладов.ОптовыйСклад;
	Если  ЕстьРеквизитОбъекта("ВидСклада",В8.Метаданные.Справочники.Склады) Тогда
		ВидСкладаУТ=В8.XMLString(СсылкаСклад.ВидСклада);
		Если ВидСкладаУТ="Розничный" Тогда
			ТипСклада=Перечисления.ТипыСкладов.РозничныйМагазин;
		ИначеЕсли ВидСкладаУТ="НТТ" Тогда
			ТипСклада=Перечисления.ТипыСкладов.НеавтоматизированнаяТорговаяТочка;
		КонецЕсли;
	КонецЕсли;	
	Возврат ТипСклада;	
КонецФункции
Функция ПолучитьГруппуНоменклатуры(ВыбНом,В8)
	СпрНом=Справочники.Номенклатура; 
	Запрос=В8.NewObject("Запрос");
	Запрос.Текст= "ВЫБРАТЬ
	|	Номенклатура.Родитель,
	|	Номенклатура.Родитель.Наименование КАК Наименование,
	|	Номенклатура.Родитель.Код КАК Код
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И НЕ Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Ссылка",ВыбНом);
	Результат = Запрос.Выполнить();    		
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	Если  ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если Объект.ВариантВыгрузкиНоменклатуры=0 Тогда
			НайденаяНом= СпрНом.НайтиПоКоду(ВыборкаДетальныеЗаписи.Код);
			Если  НайденаяНом.Пустая() Тогда
				НовНом=СпрНом.СоздатьГруппу();
				НовНом.Код=ВыборкаДетальныеЗаписи.Код;
				НовНом.Родитель= ПолучитьГруппуНоменклатуры(ВыбНом.Родитель,В8);
				НовНом.Наименование=ВыборкаДетальныеЗаписи.Наименование;
				ЗаписатьСправочник(НовНом);
				Возврат НовНом.Ссылка;
			Иначе
				Если  НайденаяНом.ЭтоГруппа Тогда
					Возврат  НайденаяНом;
				Иначе
					Сообщить("По коду "+ ВыборкаДетальныеЗаписи.Код+ " найден элемент а не группа" );
					Возврат  ?(Объект.ИспользоватьКакКореньИерархии,Объект.ГруппаНовойНоменклатуры,СпрНом.ПустаяСсылка());
				КонецЕсли;
			КонецЕсли;
		Иначе
			НайденаяНом= СпрНом.НайтиПоНаименованию(ВыборкаДетальныеЗаписи.Наименование,Истина);
			Если  НайденаяНом.Пустая() Тогда
				НовНом=СпрНом.СоздатьГруппу();
				НовНом.УстановитьНовыйКод();
				НовНом.Родитель= ПолучитьГруппуНоменклатуры(ВыбНом.Родитель,В8);
				НовНом.Наименование=ВыборкаДетальныеЗаписи.Наименование;
				ЗаписатьСправочник(НовНом);
				Возврат НовНом.Ссылка;
			Иначе
				Если  НайденаяНом.ЭтоГруппа Тогда
					Возврат  НайденаяНом;
				Иначе
					Сообщить("По наименованию "+ ВыборкаДетальныеЗаписи.Наименование+ " найден элемент а не группа" );
					Возврат  ?(Объект.ИспользоватьКакКореньИерархии,Объект.ГруппаНовойНоменклатуры,СпрНом.ПустаяСсылка());
				КонецЕсли;  
			КонецЕсли; 			 
		КонецЕсли;   		 
	Иначе
		Возврат ?(Объект.ИспользоватьКакКореньИерархии,Объект.ГруппаНовойНоменклатуры,СпрНом.ПустаяСсылка());
	КонецЕсли;
	
КонецФункции


