Функция ПолучитьГруппуКонтрагентов(ИД,В8);
	ГУИДОБЪЕКТ =  В8.NewObject("УникальныйИдентификатор",ИД);
	СсылкаНаОбъектГуид = В8.Справочники.Контрагенты.ПолучитьСсылку(ГУИДОБЪЕКТ);
	Возврат ПолучитьГруппуКонтрагентовВИсточнике(СсылкаНаОбъектГуид,В8);
КонецФункции


Функция ПолучитьГруппуКонтрагентовВИсточнике(ВыбНом,В8)
	СпрНом=Справочники.Контрагенты; 
	РодительКод=ВыбНом.Родитель.Код;
	РодительНаименование=ВыбНом.Родитель.Наименование;
	Если  ЗначениеЗаполнено(РодительКод) Тогда
		НайденаяНом= СпрНом.НайтиПоКоду(РодительКод);
		Если  НайденаяНом.Пустая() Тогда
			НовНом=СпрНом.СоздатьГруппу();
			НовНом.Код=РодительКод;
			НовНом.Родитель= ПолучитьГруппуКонтрагентовВИсточнике(ВыбНом.Родитель,В8);
			НовНом.Наименование=РодительНаименование;
			НовНом.Записать();
			Возврат НовНом.Ссылка;
		Иначе
			Если  НайденаяНом.ЭтоГруппа Тогда
				Возврат  НайденаяНом;
			Иначе
				Сообщить("По коду "+ РодительКод+ " найден элемент а не группа" );
				Возврат  ?(Объект.ИспользоватьКакКореньИерархииКонтрагентов,Объект.ГруппаНовыхКонтрагентов,СпрНом.ПустаяСсылка());
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат ?(Объект.ИспользоватьКакКореньИерархииКонтрагентов,Объект.ГруппаНовыхКонтрагентов,СпрНом.ПустаяСсылка());
	КонецЕсли;
	
КонецФункции


