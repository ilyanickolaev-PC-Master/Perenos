Процедура ТЗКонтрагентовКонтрагентПриИзменении(Элемент)
	Если Объект.ЗаписыватьСоответствияДокументов и Не ЗначениеЗаполнено(Объект.ПрефиксИБ) Тогда
		Сообщить("Для привязки необходимо указать Префикс ИБ в настройках",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	ТекДанные=Элементы.ТЗКонтрагентов.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекДанные.Контрагент) Тогда
		ТекДанные.Наименование="";
		ПроверитьГотовностьКонтрагентов(Ложь); 
		Если Объект.ЗаписыватьСоответствияДокументов  Тогда 
			Если ЗначениеЗаполнено(Объект.ВнешняяБаза) Тогда
				ОчиститьПривязку(ТекДанные.УИН, Объект.ВнешняяБаза);
				ТекДанные.ЭлементПривязан=Ложь;
				
			КонецЕсли;
			Возврат;
		КонецЕсли; 
	КонецЕсли;
	Если Объект.ЗаписыватьСоответствияДокументов Тогда 
		Если Вопрос(НСтр("ru = 'Записать соответствие контрагентов?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Если ЗначениеЗаполнено(Объект.ВнешняяБаза) Тогда
				ЗаписатьПривязку(ТекДанные.Контрагент, ТекДанные.УИН, Объект.ВнешняяБаза);
				ТекДанные.ЭлементПривязан=Истина;
				
			Иначе
				Сообщить("Не найдена внешняя база УТ, соответствие не записано",СтатусСообщения.ОченьВажное);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	ТекДанные.Наименование=ПолучитьНаименованиеКонтрагента(ТекДанные.Контрагент);
	
	ПроверитьГотовностьКонтрагентов();
	
КонецПроцедуры
