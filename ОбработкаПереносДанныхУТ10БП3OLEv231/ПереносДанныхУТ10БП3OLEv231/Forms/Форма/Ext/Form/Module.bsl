							КонецЕсли;
							СтрокаПТУ.Субконто1=НайтиСтатьюЗатратПоКоду(ВыборкаНоменклатура.СтатьяЗатратНаименование,ВыборкаНоменклатура.СтатьяЗатратКод);	 
							
							СтрокаПТУ.Количество =ВыборкаНоменклатура.Количество;
							СтрокаПТУ.Содержание =ВыборкаНоменклатура.Содержание;
							СтрокаПТУ.Цена =ЦенаБух;
							СтрокаПТУ.Сумма=СуммаБух;
