&НаСервере
Функция НайтиСтатью(СсылкаСтатья,Наименование,Код,В8)
	
	Если Объект.ВариантВыгрузкиСтатейДДС=0 Тогда 			 
		
		НайденнаяСтатья=Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(Код);
		Если  НайденнаяСтатья.Пустая() Тогда
			НовСтатья=Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
			НовСтатья.Код=Код;
			НовСтатья.Наименование=Наименование;
			ЗаписатьСправочник(НовСтатья);    
			Сообщить("Создана Статья ДДС  "+Наименование); 
			Возврат НовСтатья.Ссылка;
		Иначе
			Возврат НайденнаяСтатья;
		КонецЕсли;
		
	ИначеЕсли Объект.ВариантВыгрузкиСтатейДДС=1 Тогда
		УИНСтатьи=В8.String(СсылкаСтатья.УникальныйИдентификатор());
		СтруктураПоиска=Новый Структура("УИН");
		СтруктураПоиска.Уин=УИНСтатьи;
		СтрокаСтатья=ТЗСтатейДДС.НайтиСтроки(СтруктураПоиска);
		Если Не СтрокаСтатья.Количество()>0 Тогда
			Сообщить("Не найдена статья ДДС  "+Наименование);
			//		 ЭлементыФормы.Индикатор1.Значение=ЭлементыФормы.Индикатор1.Значение+1;		 
			Возврат Неопределено;
		КонецЕсли;
		Статья=СтрокаСтатья[0].СтатьяДДС;
		Если Не Значениезаполнено(Статья) Тогда
			Сообщить("Не найдена статья ДДС  "+Наименование);
			//		 ЭлементыФормы.Индикатор1.Значение=ЭлементыФормы.Индикатор1.Значение+1;		 
			Возврат Неопределено;
		КонецЕсли; 
		Возврат Статья;  		  
	Иначе
		НайденнаяСтатья=Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(Наименование,Истина);
		Если  НайденнаяСтатья.Пустая() Тогда
			НовСтатья=Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
			НовСтатья.УстановитьНовыйКод();
			НовСтатья.Наименование=Наименование;
			ЗаписатьСправочник(НовСтатья);
			Возврат НовСтатья.Ссылка;
		Иначе
			Возврат НайденнаяСтатья;
		КонецЕсли; 	
	КонецЕсли;	
КонецФункции
&НаСервере
Функция ПолучитьСебестоимостьСписания(В8,СсылкаДок)
	
	
	Запрос = В8.NewObject("Запрос");
	Запрос.Текст =            "ВЫБРАТЬ
	|	ЕстьNull(СУММА(ПартииТоваровНаСкладах.Стоимость),0) КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваровНаСкладах КАК ПартииТоваровНаСкладах
	|ГДЕ
	|	ПартииТоваровНаСкладах.Регистратор = &СсылкаВУт";
	
	Запрос.УстановитьПараметр("СсылкаВУт", СсылкаДок);			   
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Стоимость=NULL Тогда Возврат 0; КонецЕсли;
		Возврат ?(Выборка.Стоимость>=0,Выборка.Стоимость,-1*Выборка.Стоимость);
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаСервере
Функция ПолучитьТаблицуПартий(В8,СсылкаДок)
	
	
	Запрос = В8.NewObject("Запрос");
	Запрос.Текст =            "ВЫБРАТЬ
	|	ПТ.Номенклатура,
	|	ПТ.ХарактеристикаНоменклатуры,
	|	ПТ.СерияНоменклатуры,
	|	ПТ.Количество * ПТ.Номенклатура.ЕдиницаХраненияОстатков.Коэффициент КАК Количество,
	|	ПТ.СтатусПартии,
	|	ПТ.ДокументОприходования,
	|	ПТ.Стоимость + ЕСТЬNULL(ПартииОТЛ.Стоимость, 0) КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваровНаСкладах КАК ПТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПартииТоваровНаСкладах.НомерСтрокиСписанныхТоваров КАК НомерСтроки,
	|			СУММА(ПартииТоваровНаСкладах.Стоимость) КАК Стоимость
	|		ИЗ
	|			РегистрНакопления.ПартииТоваровНаСкладах КАК ПартииТоваровНаСкладах
	|		ГДЕ
	|			ПартииТоваровНаСкладах.ДокументДвижения = &СсылкаВУт
	|			И НЕ ПартииТоваровНаСкладах.КодОперации = ЗНАЧЕНИЕ(Перечисление.КодыОперацийПартииТоваров.ОтложеннаяОтгрузка)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ПартииТоваровНаСкладах.НомерСтрокиСписанныхТоваров) КАК ПартииОТЛ
	|		ПО ПТ.НомерСтроки = ПартииОТЛ.НомерСтроки
	|ГДЕ
	|	ПТ.Регистратор = &СсылкаВУт
	|	И ПТ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	
	Запрос.УстановитьПараметр("СсылкаВУт", СсылкаДок);			   
	РезЗапроса=Запрос.Выполнить();
	Если  РезЗапроса=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат РезЗапроса.Выгрузить();
КонецФункции


