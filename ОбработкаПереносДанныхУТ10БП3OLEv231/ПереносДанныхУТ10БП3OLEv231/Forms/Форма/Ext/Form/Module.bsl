Функция ПолучитьПризнак(ХозяйственнаяОперация,Признак)
	Если  ХозяйственнаяОперация="ОплатаПоставщику" Тогда
		Возврат "Оплата поставщику";
	ИначеЕсли  ХозяйственнаяОперация="ВозвратДенежныхСредствПокупателю" Тогда
		Возврат "Возврат оплаты клиенту";
	ИначеЕсли  ХозяйственнаяОперация="ПоступленияОтПродажиИностраннойВалюты" Тогда
		Возврат "ПоступленияОтПродажиИностраннойВалюты";	
	ИначеЕсли  ХозяйственнаяОперация="ПриобретениеИностраннойВалюты" Тогда
		Возврат "ПриобретениеИностраннойВалюты";
	ИначеЕсли  ХозяйственнаяОперация="ПеречислениеДенежныхСредствПодотчетнику" Тогда
		Возврат "Перечисление денежных средств подотчетнику";
	ИначеЕсли  ХозяйственнаяОперация="ПеречислениеНалога" Тогда
		Возврат "Перечисление налога";
	ИначеЕсли  ХозяйственнаяОперация="ПрочееСписаниеБезналичныхДенежныхСредств" Тогда
		Возврат "Прочее списание безналичных денежных средств";
	ИначеЕсли  ХозяйственнаяОперация="ПрочееПоступлениеБезналичныхДенежныхСредств" Тогда
		Возврат "Прочее поступление безналичных денежных средств";
	ИначеЕсли  ХозяйственнаяОперация="ОплатаПокупателя" Тогда
		Возврат "Поступление оплаты от клиента";
	ИначеЕсли  ХозяйственнаяОперация="ВозвратДенежныхСредствПоставщиком" Тогда
		Возврат "Возврат денежных средств от поставщика";
	ИначеЕсли  ХозяйственнаяОперация="РасчетыПоКредитамИЗаймамСКонтрагентами" Или ХозяйственнаяОперация="РасчетыПоКредитамИЗаймам" Тогда
		Возврат "РасчетыПоКредитамИЗаймамСКонтрагентами";
	ИначеЕсли  ХозяйственнаяОперация="ПрочиеРасчетыСКонтрагентами" Тогда
		Возврат "ПрочиеРасчетыСКонтрагентами";  
	ИначеЕсли  ХозяйственнаяОперация="ПоступлениеОплатыПоПлатежнымКартам" Тогда
		Возврат "Поступление оплаты по картам";
	ИначеЕсли  ХозяйственнаяОперация="ПоступлениеОплатыПоБанковскимКредитам" Тогда
		Возврат "Поступление оплаты по банковским кредитам";  
	ИначеЕсли  ХозяйственнаяОперация="ПриходДенежныхСредствРозничнаяВыручка" Тогда
		Возврат "ПриходДенежныхСредствРозничнаяВыручка";  
		
	Иначе 
		Возврат Признак
	КонецЕсли;     
КонецФункции

&НаСервере
Процедура ОбновитьНоменклатуруВБПНаСервере()
	Если	Объект.ВариантВыгрузкиНоменклатуры=1 Тогда
		Сообщить("Обновление номенклатуры реализовано для настройки поиска по коду, артикулу, или наименованию");
		Возврат;
	КонецЕсли;
	
	
	В8=Соединение();
	Запрос = В8.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка как Номенклатура,
	|	Номенклатура.Код Как НоменклатураКод,
	|	Номенклатура.Наименование Как НоменклатураНаименование,
	|	Номенклатура.НаименованиеПолное КАК НомНаименованиеПолное,
	|	Номенклатура.БазоваяЕдиницаИзмерения Как ЕдиницаИзмерения,
	|  Номенклатура.НоменклатурнаяГруппа.Наименование   Как НоменклатурнаяГруппа,
	|	Номенклатура.Услуга, 	 
	|	Номенклатура.Артикул КАК НомАртикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = ЛОЖЬ";                
	Результат = Запрос.Выполнить(); 	
	
	ВыборкаНоменклатура = Результат.Выбрать(); 
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		ВыбНомКод=ВыборкаНоменклатура.НоменклатураКод;
		ВыбНом=ВыборкаНоменклатура.Номенклатура;
		ВыбНомНаименование=ВыборкаНоменклатура.НоменклатураНаименование;
		ВыбНомНаименованиеПолное=ВыборкаНоменклатура.НомНаименованиеПолное;
		ВыбНомАртикул=ВыборкаНоменклатура.НомАртикул;
		УИННом=В8.String(ВыбНом.УникальныйИдентификатор());
		СтавкаНДС=ПолучитьСтавкуНДС(ВыбНом.СтавкаНДС,В8);
		шт=НайтиЕдИзм(ВыборкаНоменклатура.ЕдиницаИзмерения);
		НайденаяНом= НайтиНоменклатуру(УИННом,ВыбНомНаименование,ВыбНомКод,СтавкаНДС,шт,ВыбНомНаименованиеПолное,ВыбНомАртикул,ВыбНом,В8,Ложь,ВыборкаНоменклатура.Услуга); 
		Если Не   НайденаяНом.Пустая() Тогда
			Месэдж="Номенклатура: "+НайденаяНом.Наименование +" код "+НайденаяНом.Код+Символы.ПС;
			ОбъектИзменён=Ложь;
			Если Объект.ЗаменятьНаименованиеНоменклатурыНаПолное Тогда
				Если НайденаяНом.Наименование<>ВыбНомНаименованиеПолное Тогда
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
					ОбъектНом.Наименование=ВыбНомНаименованиеПолное;			
					ОбъектИзменён=Истина;	
					Месэдж=Месэдж+"Изменилось наименование с "+НайденаяНом.Наименование+" на "+ВыбНомНаименованиеПолное+Символы.ПС;
				КонецЕсли;
			Иначе
				
				Если НайденаяНом.Наименование<>ВыбНомНаименование Тогда
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
					ОбъектНом.Наименование=ВыбНомНаименование;			
					ОбъектИзменён=Истина;	
					Месэдж=Месэдж+"Изменилось наименование с "+НайденаяНом.Наименование+" на "+ВыбНомНаименование+Символы.ПС;
				КонецЕсли;
			КонецЕсли;
			
			
			Если НайденаяНом.Услуга<>ВыборкаНоменклатура.Услуга Тогда
				Если Не ОбъектИзменён Тогда 
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
				КонецЕсли;
				ОбъектНом.Услуга=ВыборкаНоменклатура.Услуга;			
				ОбъектИзменён=Истина;	
				Месэдж=Месэдж+"Изменился признак Услуги с "+НайденаяНом.Услуга+" на "+ВыборкаНоменклатура.Услуга+Символы.ПС;
			КонецЕсли;  
			
			Если НайденаяНом.Артикул<>ВыбНомАртикул Тогда
				Если Не ОбъектИзменён Тогда 
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
				КонецЕсли;
				ОбъектНом.Артикул=ВыбНомАртикул;			
				ОбъектИзменён=Истина;	
				Месэдж=Месэдж+"Изменился Артикул с "+НайденаяНом.Артикул+" на "+ВыбНомАртикул+Символы.ПС;
			КонецЕсли;  
			Если НайденаяНом.НаименованиеПолное<>ВыбНомНаименованиеПолное Тогда
				Если Не ОбъектИзменён Тогда 
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
				КонецЕсли;
				ОбъектНом.НаименованиеПолное=ВыбНомНаименованиеПолное;			
				ОбъектИзменён=Истина;	
				Месэдж=Месэдж+"Изменилось наименование полное с "+НайденаяНом.НаименованиеПолное+" на "+ВыбНомНаименованиеПолное+Символы.ПС;
			КонецЕсли;  
			Если НайденаяНом.Код<>ВыбНомКод Тогда
				Если Не ОбъектИзменён Тогда 
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
				КонецЕсли;
				ОбъектНом.Код=ВыбНомКод;			
				ОбъектИзменён=Истина;	
				Месэдж=Месэдж+"Изменился Код с "+НайденаяНом.Код+" на "+ВыбНомКод+Символы.ПС;
			КонецЕсли;  
			Если НайденаяНом.НоменклатурнаяГруппа<>ВыборкаНоменклатура.НоменклатурнаяГруппа Тогда
				
				Если Не ОбъектИзменён Тогда 
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
				КонецЕсли;
				НомГруппа=ПолучитьНоменклатурнуюГруппу(ВыборкаНоменклатура.НоменклатурнаяГруппа);
				ОбъектНом.НоменклатурнаяГруппа=НомГруппа;			
				ОбъектИзменён=Истина;	
				Месэдж=Месэдж+"Изменилась Номенклатурная группа с "+НайденаяНом.НоменклатурнаяГруппа+" на "+ВыборкаНоменклатура.НоменклатурнаяГруппа+Символы.ПС;
			КонецЕсли;  
			
			//НовНом.Родитель=ПолучитьГруппуНоменклатуры(ВыбНом); 
			Попытка
				Группа=ПолучитьГруппуНоменклатуры(ВыбНом,В8);
			Исключение
				Сообщить(ОписаниеОшибки());
				Сообщить("Не удалось поменять группу у "+НайденаяНом.Наименование +"с кодом "+НайденаяНом.Код+Символы.ПС);
				Продолжить
			КонецПопытки;
			Если НайденаяНом.Родитель<>Группа Тогда
				Если Не ОбъектИзменён Тогда 
					ОбъектНом=НайденаяНом.ПолучитьОбъект();
				КонецЕсли;
				ОбъектНом.родитель=Группа;			
				ОбъектИзменён=Истина;	
				Месэдж=Месэдж+"Изменилась группа с "+НайденаяНом.Родитель+" на "+Группа+Символы.ПС;
			КонецЕсли; 
			
			Если ОбъектИзменён Тогда
				Попытка ЗаписатьСправочник(ОбъектНом);
					Сообщить(Месэдж);
				Исключение
					Сообщить(ОписаниеОшибки());
				КонецПопытки;   		  
			КонецЕсли;
		КонецЕсли;	 
	КонецЦикла;
КонецПроцедуры

