									СтрокаПТУ.СтавкаНДСВРознице =СтавкаНДС;
								КонецЕсли;
							КонецЕсли;
							
							СведенияОНоменклатуре = БухгалтерскийУчетПереопределяемый.ПолучитьСведенияОНоменклатуре(НайденаяНом,ДанныеОбъекта);
							Документы.ПоступлениеТоваровУслуг.ЗаполнитьСчетаУчетаВСтрокеТабличнойЧасти(ДанныеОбъекта, СтрокаПТУ, "Товары", СведенияОНоменклатуре);
							СтрокаПТУ.СчетУчетаНДС = ПланыСчетов.Хозрасчетный.НДСпоПриобретеннымМПЗ;
						КонецЕсли;
						
