	Запись.ТипПриемника = Строка(ТипЗНЧ(Объект));
	Запись.ТипИсточника = Запись.ТипПриемника;                    
	
	НаборЗаписей.ОбменДанными.Загрузка=Истина;
	НаборЗаписей.Записать();
	
