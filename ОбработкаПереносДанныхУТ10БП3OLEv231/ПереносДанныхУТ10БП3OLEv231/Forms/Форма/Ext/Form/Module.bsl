&НаСервере
Процедура ПрочитатьНаСервере()
	Отбор = Новый Структура("Пользователь,КлючОбъекта", ИмяПользователя,КлючОбъекта);
	Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
	ТаблицаДанных.Очистить();
	Пока Выборка.Следующий() Цикл 
		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.КлючОбъекта = Выборка.КлючОбъекта;
		НоваяСтрока.КлючНастроек = Выборка.КлючНастроек;
		Если ТипЗнч(Выборка.Настройки) = Тип("Структура") Тогда 
			НоваяСтрока.Значение = "<структура>";
			НоваяСтрока.Коллекция = Истина;
		ИначеЕсли ТипЗнч(Выборка.Настройки) = Тип("ТаблицаЗначений") Тогда 
			НоваяСтрока.Значение = "<таблица>";
			НоваяСтрока.Коллекция = Истина;
		ИначеЕсли ТипЗнч(Выборка.Настройки) = Тип("СписокЗначений") Тогда 
			НоваяСтрока.Значение = "<список>";
			НоваяСтрока.Коллекция = Истина;
		ИначеЕсли ТипЗнч(Выборка.Настройки) = Тип("Соответствие") Тогда 
			НоваяСтрока.Значение = "<соответствие>";
			НоваяСтрока.Коллекция = Истина;
		ИначеЕсли ТипЗнч(Выборка.Настройки) = Тип("Массив") Тогда 
			НоваяСтрока.Значение = "<массив>";
			НоваяСтрока.Коллекция = Истина;
		Иначе
			НоваяСтрока.Значение = Выборка.Настройки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
&НаКлиенте
