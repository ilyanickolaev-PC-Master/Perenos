		"ВЫБРАТЬ
		|	Номенклатура.Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Код = &Код
		|	И НЕ Номенклатура.ЭтоГруппа";
		
		Запрос.УстановитьПараметр("Код", Код);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		НайденаяНом=Справочники.Номенклатура.ПустаяСсылка();	
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			НайденаяНом=ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
		Если  НайденаяНом.Пустая() Тогда
			НовНом=СпрНом.СоздатьЭлемент();
			НовНом.Код=Код;
			Если Объект.ПереноситьИерархиюНоменклатуры Тогда
				НовНом.Родитель=ПолучитьГруппуНоменклатуры(ВыбНом,В8); 
			Иначе      				 
				НовНом.Родитель= Объект.ГруппаНовойНоменклатуры;
			КонецЕсли;
			//НовНом.Родитель= Объект.ГруппаНовойНоменклатуры;
			Если Объект.ЗаменятьНаименованиеНоменклатурыНаПолное Тогда
				НовНом.Наименование=НаименованиеПолное;
			Иначе
				НовНом.Наименование=Наименование;
			КонецЕсли;
			Если ЕстьРеквизитОбъекта("СтавкаНДС",  Метаданные.Справочники.Номенклатура) Тогда
				НовНом.СтавкаНДС=СтавкаНДС;
			ИначеЕсли ЕстьРеквизитОбъекта("ВидСтавкиНДС",  Метаданные.Справочники.Номенклатура) Тогда
				НовНом.ВидСтавкиНДС=Перечисления.ВидыСтавокНДС.ВидСтавки( СтавкаНДС);
			КонецЕсли;
			
			НовНом.ЕдиницаИзмерения=ЕДИзмерения;
			НовНом.НаименованиеПолное=НаименованиеПолное;
			НовНом.Артикул=Артикул;
			НовНом.Услуга =Услуга;
			НовНом.НоменклатурнаяГруппа=Справочники.НоменклатурныеГруппы.НайтиПоНаименованию(НомГруппа);
			Если УстанавливатьВидНоменклатуры Тогда
				НовНом.ВидНоменклатуры=ПолучитьВидНоменклатуры(ВыбНом);	
			КонецЕсли;
			
			ЗаписатьСправочник(НовНом);
			Возврат НовНом.Ссылка;
		Иначе
			Возврат  НайденаяНом;
		КонецЕсли;
	ИначеЕсли	Объект.ВариантВыгрузкиНоменклатуры=1 Тогда
		Если ЗначениеЗаполнено(Объект.НоменклатураЗамены) Тогда
