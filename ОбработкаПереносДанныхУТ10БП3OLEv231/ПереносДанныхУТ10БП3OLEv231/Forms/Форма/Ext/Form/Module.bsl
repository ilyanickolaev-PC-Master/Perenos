							НомерСФ=ВыборкаСФ.Номер;	 
							ДатаСФ=ВыборкаСФ.Дата;	 
						КонецЕсли;
						Если НЕ НомерСФ="" и НЕ  ДатаСФ="" Тогда
							ДокСсылкаСФ=ПолучитьСчётФактуруПолученную(ДокСсылка);
							МенятьНомер=Истина;					 
							Если ДокСсылкаСФ.Пустая() Тогда 
								ДокСФ=Документы.СчетФактураПолученный.СоздатьДокумент();
								ДокСФ.Заполнить(ДокСсылка);
							Иначе    					 
								ДокСФ=ДокСсылкаСФ.ПолучитьОбъект();
								МенятьНомер=Ложь;
							КонецЕсли;						 
							ДокСФ.Дата=ДатаСФ;
							Если МенятьНомер Тогда
								Если Объект.Нумерация=0 Тогда
									
									ДокСФ.Номер=?(Объект.УбиратьИзНомераПрефиксРаспределеннойБазы,СтрЗаменить(НомерСФ,ПрефиксИБКонстанта,""),НомерСФ);
								Иначе
									ДокСФ.УстановитьНовыйНомер();
