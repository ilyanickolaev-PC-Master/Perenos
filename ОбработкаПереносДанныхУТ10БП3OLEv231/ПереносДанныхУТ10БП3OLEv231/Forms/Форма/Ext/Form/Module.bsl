&НаСервере
Функция ЗаписатьПровестиДокумент(ИсточникПроведён,СсылкаНаДок,МенятьНомер,ТипДок,ВыборкаКонтрагент,В8,СтруктураФильтров=Неопределено)
	СсылкаНаДок.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью",истина);
	Если Объект.ОбменДаннымиЗагрузка Тогда
		СсылкаНаДок.ОбменДанными.Загрузка=Истина;
	КонецЕсли;
	Отказ=Ложь;
	ОбработатьОбъектПередЗаписью(СсылкаНаДок,ВыборкаКонтрагент,Отказ); 
	ОбработатьОбъектПередЗаписьюНеПереопределяемая(СсылкаНаДок,ВыборкаКонтрагент,Отказ,В8,СтруктураФильтров); 
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;                                                                                
	
	Если НЕ  ИсточникПроведён Тогда
		Попытка
			СсылкаНаДок.Записать();
			СообщениеОЗаписи(?(МенятьНомер,"Создан и записан","Перезаполнен и записан"),"документ","РТУ",СсылкаНаДок.Номер);	
		Исключение
			Сообщить("Не удалось записать документ "+ТипДок+" № "+СсылкаНаДок.Номер);
			Сообщить(ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	Иначе
		Если Объект.ПроводитьДокументы Тогда
			ЗаписатьДокумент=Ложь;
			Попытка
				СсылкаНаДок.Записать(РежимЗаписиДокумента.Проведение);
				СообщениеОЗаписи(?(МенятьНомер,"Создан и проведён","Перезаполнен и проведён"),"документ",ТипДок,СсылкаНаДок.Номер);
			Исключение;
				ЗаписатьДокумент=Истина;
				Сообщить("Не удалось провести документ № "+СсылкаНаДок.Номер);  				
			КонецПопытки;
			Если  ЗаписатьДокумент Тогда
				Попытка
					СсылкаНаДок.Записать();
					СообщениеОЗаписи(?(МенятьНомер,"Создан и записан","Перезаполнен и записан"),"документ",ТипДок,СсылкаНаДок.Номер);						
				Исключение
					Сообщить("Не удалось записать документ "+ТипДок+" № "+СсылкаНаДок.Номер); 
					Сообщить(ОписаниеОшибки());
					Возврат Ложь;	
				КонецПопытки;
			КонецЕсли;	
		Иначе
			Если Объект.ОтменятьПроведениеПерезаписываемогоДокумента Тогда
				Попытка
					Если СсылкаНаДок.Проведен Тогда
						СсылкаНаДок.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					Иначе
						СсылкаНаДок.Записать();
					КонецЕсли;
					СообщениеОЗаписи(?(МенятьНомер,"Создан и записан","Перезаполнен и записан"),"документ",ТипДок,СсылкаНаДок.Номер);	
				Исключение
					Сообщить("Не удалось записать документ "+ТипДок+" № "+СсылкаНаДок.Номер);
					Сообщить(ОписаниеОшибки());
					Возврат Ложь;
				КонецПопытки;		 
			Иначе
				Попытка
					СсылкаНаДок.Записать();
					СообщениеОЗаписи(?(МенятьНомер,"Создан и записан","Перезаполнен и записан"),"документ",ТипДок,СсылкаНаДок.Номер);	
				Исключение
					Сообщить("Не удалось записать документ "+ТипДок+" № "+СсылкаНаДок.Номер);
					Сообщить(ОписаниеОшибки());
					Возврат Ложь;
				КонецПопытки;					 
			КонецЕсли; 
		КонецЕсли;	 
	КонецЕсли;
	Возврат Истина;
КонецФункции

