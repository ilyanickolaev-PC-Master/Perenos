Функция НайтиДоговорКонтрагента(Контр,ДоговорКонтрагентаНаименование,ДоговорКонтрагентаНомер,ДоговорКонтрагентаДата,ДоговорКонтрагентаСрокДействия,Валюта,Организация,ТипДоговора,В8,ДогСсылка)
	Если Не ЗначениеЗаполнено(ДоговорКонтрагентаНаименование)	 Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	НайденныйДоговор=Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(ДоговорКонтрагентаНаименование,Истина,,Контр);
	Если  НайденныйДоговор.Пустая() Тогда
		НовДоговор=Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовДоговор.УстановитьНовыйКод();
		НовДоговор.Наименование=ДоговорКонтрагентаНаименование;
		НовДоговор.Номер=ДоговорКонтрагентаНомер;
		НовДоговор.Дата=ДоговорКонтрагентаДата;
		НовДоговор.СрокДействия=ДоговорКонтрагентаСрокДействия;
		НовДоговор.Владелец=Контр;
		НовДоговор.ВалютаВзаиморасчетов=НайтиСоздатьВалюту(ДогСсылка.ВалютаВзаиморасчетов);   
		НовДоговор.РасчетыВУсловныхЕдиницах=ДогСсылка.РасчетыВУсловныхЕдиницах;
		//НовДоговор.ВалютаВзаиморасчетов =   Валюта;
		ТипДог=В8.XMLString(ТипДоговора);
		Если ТипДог="СПокупателем"  Тогда
			НовДоговор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		ИначеЕсли  ТипДог="СПоставщиком"  Тогда
			НовДоговор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ИначеЕсли  ТипДог="СКомиссионером"  Тогда
			НовДоговор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером;
		ИначеЕсли  ТипДог="СКомитентом"  Тогда
			НовДоговор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;
		Иначе
			НовДоговор.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.Прочее;
		КонецЕсли;
		
		НовДоговор.Организация=Организация;
		ЗаписатьСправочник(НовДоговор);
		Возврат НовДоговор.Ссылка;
	Иначе
		Возврат НайденныйДоговор;
	КонецЕсли; 	
КонецФункции

