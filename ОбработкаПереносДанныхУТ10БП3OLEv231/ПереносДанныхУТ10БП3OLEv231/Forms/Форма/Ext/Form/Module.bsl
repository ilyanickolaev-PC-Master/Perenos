	МетСБДС=Метаданные.Документы.СписаниеСРасчетногоСчета;      
	ЕстьФизЛицо= Не МетСБДС.Реквизиты.Найти("ФизЛицо") = Неопределено;
	МетСчетов=Метаданные.Документы.СчетНаОплатуПокупателю;    
	ЕстьУслугиУСчетов = ЕстьТабЧастьДокумента(МетСчетов,"Услуги");
	
	Если НЕ  Объект.ТолькоОтменаПроведенияИПометка  Тогда
		Если Объект.ВыгружатьПоступления Тогда
			
			Запрос=В8.NewObject("Запрос");
			
			Запрос.Текст =	"ВЫБРАТЬ
			|	ВложенныйЗапрос.Контрагент КАК Контрагент,
