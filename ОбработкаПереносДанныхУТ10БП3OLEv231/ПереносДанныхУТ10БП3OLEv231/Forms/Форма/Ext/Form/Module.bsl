	Если Не ТЗСтатейДДС.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
		Элементы.ГотовностьСтатейДДС.Картинка=Элементы.КрасныйКрест.Картинка;
		Элементы.КнСоздатьДокументы.Доступность=ложь;
		Элементы.КнПредварительныйПросмотр.Доступность=ложь;   
		ЭтаФорма.СтатьиПроверены=ЛОЖЬ;  
		Возврат;
	КонецЕсли;	 
	Элементы.ГотовностьСтатейДДС.Картинка=Элементы.ЗелёнаяГалка.Картинка;
	ЭтаФорма.СтатьиПроверены=Истина;		 
	Если ?(Объект.ВариантВыгрузкиНоменклатуры=0 или Объект.ВариантВыгрузкиНоменклатуры=2 Или Объект.ВариантВыгрузкиНоменклатуры=3  или Объект.ВариантВыгрузкиНоменклатуры=4,Истина,ЭтаФорма.НоменклатураПроверена) И ЭтаФорма.КонтрагентыПроверены И ?(Объект.ВариантВыгрузкиСкладов=0 или Объект.ВариантВыгрузкиСкладов=2,Истина,ЭтаФорма.СкладыПроверены) Тогда
		Элементы.КнСоздатьДокументы.Доступность=Истина;
		Элементы.КнПредварительныйПросмотр.Доступность=Истина;	 
	КонецЕсли;
	
	
	//Если НоменклатураПроверена И КонтрагентыПроверены Тогда
