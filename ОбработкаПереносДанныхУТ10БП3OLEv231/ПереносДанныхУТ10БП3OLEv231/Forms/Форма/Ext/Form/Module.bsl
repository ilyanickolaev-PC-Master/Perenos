Функция СоздатьДоговор_сервер(Контрагент,Организация,Покупка,Валюта,Прочее,Наим="",ВидДоговора=Неопределено)
	Дог=Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Дог.Организация=Организация;
	Дог.Владелец=Контрагент;
	//Дог.ВалютаВзаиморасчетов=Константы.ВалютаРегламентированногоУчета.Получить();
	Дог.ВалютаВзаиморасчетов=Валюта; 
	Если Не ВидДоговора=Неопределено Тогда
		Дог.ВидДоговора =ВидДоговора;
	Иначе
		Если  Прочее Тогда
			Дог.ВидДоговора=Перечисления.ВидыДоговоровКонтрагентов.Прочее; 
		Иначе
			Если Покупка Тогда
