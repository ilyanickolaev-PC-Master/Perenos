&НаСервере
Функция НайтиСоздатьБанковскийСчёт(НомерСчета,ВладелецСчета,БикБанка,КоррСчет,ГородБанка,АдресБанка,ТелефоныБанка,НаименованиеБанка,Валюта)
	СчетОрганизации=Справочники.БанковскиеСчета.НайтиПоРеквизиту("НомерСчета",НомерСчета,,ВладелецСчета);
	Если СчетОрганизации.Пустая() Тогда
		Банк=Справочники.Банки.НайтиПоКоду(БИКБанка); 
		Если Банк.Пустая() Тогда
			БанкОбъект=Справочники.Банки.СоздатьЭлемент();
			БанкОбъект.Код=БИКБанка;
			БанкОбъект.КоррСчет=КоррСчет;                   
			БанкОбъект.Город=ГородБанка;                    
			БанкОбъект.Адрес=АдресБанка;
			БанкОбъект.Телефоны=ТелефоныБанка;
			БанкОбъект.Наименование=НаименованиеБанка;
			ЗаписатьСправочник(БанкОбъект);
			Банк=БанкОбъект.Ссылка;
		КонецЕсли;
		СчётОргОбъект=Справочники.БанковскиеСчета.СоздатьЭлемент();	 
		СчётОргОбъект.НомерСчета=НомерСчета;	 
		СчётОргОбъект.Банк=Банк;	                                    
		СчётОргОбъект.ВалютаДенежныхСредств=Валюта;	  
		СчётОргОбъект.ВидСчета="Расчетный";
		СчётОргОбъект.Наименование=СчётОргОбъект.НомерСчета;
		СчётОргОбъект.Владелец=ВладелецСчета;
		ЗаписатьСправочник(СчётОргОбъект);
		Возврат СчётОргОбъект.Ссылка;
	КонецЕсли; 
	Возврат  СчетОрганизации;	 
КонецФункции





&НаСервере
Функция Соединение()
	//ОбработкаПрерыванияПользователя(); 
	//Состояние("соединение с УТ11");	   ОбщегоНазначения.ИмяCOMСоединителя().
	//ИмяСоединения=ОбщегоНазначения.ИмяCOMСоединителя();
	Если Не ЭтаФорма.АдресКомОбъекта="" и Объект.ДержатьСоединениеОткрытым Тогда
		СтруктураВ8=  ПолучитьИзВременногоХранилища(АдресКомОбъекта);
		Если Не СтруктураВ8=Неопределено Тогда
			В8 =СтруктураВ8.Объект;
			Если В8 = Неопределено Тогда
				ЭтаФорма.АдресКомОбъекта = "";
				В8 = Соединение();
			КонецЕсли; 
		КонецЕсли;
		Возврат В8;
	КонецЕсли;
	Если Объект.ВариантПодключения=0 Тогда
		Если Объект.ТипКоннектора=0  Тогда
			ИмяСоединения=ИмяCOMСоединителя();
		Иначе
			ИмяСоединения="V83.Application";
		КонецЕсли;
		
	ИначеЕсли Объект.ВариантПодключения=1 Тогда		
		Если Объект.ТипКоннектора=0  Тогда
			ИмяСоединения="V82.ComConnector";
		Иначе
			ИмяСоединения="V82.Application";
		КонецЕсли;
	ИначеЕсли Объект.ВариантПодключения=2 Тогда	
		Если Объект.ТипКоннектора=0  Тогда
			ИмяСоединения="V83.ComConnector";
		Иначе
			ИмяСоединения="V83.Application";
		КонецЕсли;
	ИначеЕсли Объект.ВариантПодключения=3 Тогда	
		Если Объект.ТипКоннектора=0  Тогда
			ИмяСоединения="V81.ComConnector";
		Иначе
			ИмяСоединения="V81.Application";
		КонецЕсли;
	КонецЕсли;
	
	
	V8=Новый ComОбъект(ИмяСоединения);
	Если Объект.ТипСоединения=1 Тогда
		ПараметрыСоединения="Srvr="""+СокрЛП(Объект.Сервер)+"""; Ref="""+СокрЛП(Объект.База)+"""";
	Иначе
		ПараметрыСоединения="File=""" + СокрЛП(Объект.Путь) + """";
	КонецЕсли;
	Если Не Объект.АутентификацияОС Тогда
		ПараметрыСоединения=ПараметрыСоединения+"; Usr="""+СокрЛП(Объект.Пользователь)+"""; Pwd="""+СокрЛП(Объект.Пароль)+""";";
	КонецЕсли;
	
	Попытка
		В8=V8.Connect(ПараметрыСоединения);
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	Если Объект.ТипКоннектора=0  Тогда
		Если Объект.ДержатьСоединениеОткрытым Тогда
			Структура               = New Структура("Объект", В8);
			ЭтаФорма.АдресКомОбъекта = ПоместитьВоВременноеХранилище(Структура,ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
		Возврат В8;
	Иначе
		Если Объект.ДержатьСоединениеОткрытым Тогда
			Структура               = New Структура("Объект", V8);
			ЭтаФорма.АдресКомОбъекта = ПоместитьВоВременноеХранилище(Структура,ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
		V8.visible=Объект.ПоказыватьСеанс;
		Возврат V8;  		
	КонецЕсли;
	
	
КонецФункции

&НаСервере
Процедура ПолучитьДанные_сервер()
	ЕстьПомеченныеОбъекты=Ложь;
	Для Каждого ЭлСписка Из Объект.СписокОбъектов Цикл
		Если ЭлСписка.Пометка Тогда
			ЕстьПомеченныеОбъекты=Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ  ЕстьПомеченныеОбъекты Тогда
		Сообщить("В списке объектов для переноса ничего не выбрано!");  
		Возврат; 
	КонецЕсли;
	
	Рубли=Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если   Не Метаданные.ПланыОбмена.Найти("УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30")=Неопределено Тогда
		Объект.ВнешняяБаза=ПланыОбмена.УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30.НайтиПоКоду(Объект.ПрефиксИБ);	
	ИначеЕсли  Не Метаданные.ПланыОбмена.Найти("УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30")=Неопределено Тогда 
		Объект.ВнешняяБаза=ПланыОбмена.УдалитьОбменУправлениеТорговлейБухгалтерияПредприятияКОРП30.НайтиПоКоду(Объект.ПрефиксИБ);	
	КонецЕсли;
	В8=Соединение();
	Если В8=Неопределено Тогда
		Сообщить("Не удалось подключиться к БД");
		Возврат;
	КонецЕсли;	
	ПрефиксИБКонстанта=?(ЗначениеЗаполнено(Объект.ПрефиксИсточника),Объект.ПрефиксИсточника,В8.Константы.ПрефиксУзлаРаспределеннойИнформационнойБазы.Получить());
	РубВ8=В8.Константы.ВалютаРегламентированногоУчета.Получить();
	МассивИНН=В8.NewObject("Массив");
	Для Каждого ЭлСп Из Объект.Организации Цикл
		ОргИзСписка=ЭлСп.Значение;
		Если Не ОргИзСписка.Пустая()  Тогда 
			Если ЗначениеЗаполнено(ОргИзСписка.ИНН) Тогда
				МассивИНН.Добавить(ОргИзСписка.ИНН);
			КонецЕсли;      			 
		КонецЕсли;
	КонецЦикла;
	
	ТЗКонтрагентов.Очистить();
	СпрКонтр=Справочники.Контрагенты;
	СпрОрг=Справочники.Организации;
	Запрос=В8.NewObject("Запрос");
	Запрос.Текст =                                                                         "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВложенныйЗапрос.КонтрагентИНН КАК КонтрагентИНН,
	|	ВложенныйЗапрос.ОрганизацияИНН КАК ОрганизацияИНН,
	|	ВложенныйЗапрос.НаименованиеКонтр,
	|	ВложенныйЗапрос.КПП,
	|	ВложенныйЗапрос.НаименованиеПолное,
	|	ВложенныйЗапрос.ЮрЛицо,
	|	ВложенныйЗапрос.Поставщик КАК Поставщик,
	|	ВложенныйЗапрос.Признак КАК Признак,
	|	ВложенныйЗапрос.Контрагент,
	|	ВложенныйЗапрос.Валюта,
	|	ВложенныйЗапрос.Прочее,
	|	ВложенныйЗапрос.ХозяйственнаяОперация
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступлениеТоваровУслуг.Контрагент.ИНН КАК КонтрагентИНН,
	|		ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
	|		ПоступлениеТоваровУслуг.Контрагент.Наименование КАК НаименованиеКонтр,
	|		ПоступлениеТоваровУслуг.Контрагент.КПП КАК КПП,
	|		ПОДСТРОКА(ПоступлениеТоваровУслуг.Контрагент.НаименованиеПолное, 1, 250) КАК НаименованиеПолное,
	|		ВЫБОР
	|			КОГДА ПоступлениеТоваровУслуг.Контрагент.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЮрЛицо,
	|		ИСТИНА КАК Поставщик,
	|		""Поступление товаров"" КАК Признак,
	|		ПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
	|		ПоступлениеТоваровУслуг.ВалютаДокумента КАК Валюта,
	|		ЛОЖЬ КАК Прочее,
	|		""Поступление товаров"" КАК ХозяйственнаяОперация
	|	ИЗ
	|		Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|	ГДЕ
	|		ПоступлениеТоваровУслуг.Дата МЕЖДУ &ДатаНач И &ДатаКон
