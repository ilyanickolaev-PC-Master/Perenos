	Объект.ВнешняяБаза=ПолучитьВнешнююБазуПоПрефиксу(Объект.ПрефиксИБ);	
	Если Не ЗначениеЗаполнено( Объект.ВнешняяБаза) Тогда
		Ответ = Вопрос("Не найдена внешняя база УТ, создать узел в плане обмена?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	СоздатьУзелОбменаПриемника(Объект.ПрефиксИБ);
