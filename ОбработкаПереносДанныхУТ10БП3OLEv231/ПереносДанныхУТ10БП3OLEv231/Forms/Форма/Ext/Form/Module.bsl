Функция ПолучитьСтавкуНДС(Ставка,В8)  
	СТНДС=В8.XMLString(Ставка);//Дописать
	Если СТНДС="НДС18"  Тогда
		Возврат  Перечисления.СтавкиНДС.НДС18;
	ИначеЕсли СТНДС="НДС10"  Тогда
		Возврат  Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли СТНДС="НДС0"  Тогда
		Возврат  Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли СТНДС="НДС10_110"  Тогда
		Возврат  Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли СТНДС="НДС18_118"  Тогда
		Возврат  Перечисления.СтавкиНДС.НДС18_118;
	ИначеЕсли СТНДС="НДС20"  Тогда
		Возврат  Перечисления.СтавкиНДС.НДС20;
	Иначе
		Возврат  Перечисления.СтавкиНДС.БезНДС; 
	КонецЕсли; 	 
КонецФункции
Функция ПолучитьСтавкуНДСПриемника(СТНДС,В8)  
	Если СТНДС=Перечисления.СтавкиНДС.НДС18  Тогда
		Возврат  В8.Перечисления.СтавкиНДС.НДС18;
	ИначеЕсли СТНДС=Перечисления.СтавкиНДС.НДС10  Тогда
		Возврат  В8.Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли СТНДС=Перечисления.СтавкиНДС.НДС0  Тогда
		Возврат  В8.Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли СТНДС=Перечисления.СтавкиНДС.НДС10_110  Тогда
		Возврат  В8.Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли СТНДС= Перечисления.СтавкиНДС.НДС18_118  Тогда
		Возврат  В8.Перечисления.СтавкиНДС.НДС18_118;
	Иначе
		Возврат  В8.Перечисления.СтавкиНДС.БезНДС; 
	КонецЕсли; 	 
КонецФункции
Функция ПолучитьТипОплаты(ТипОплаты,В8)
	ТО=В8.XMLString(ТипОплаты);//Дописать
	Если ТО="Наличные"  Тогда                      
		Возврат  Перечисления.ТипыОплат.Наличные;
	ИначеЕсли ТО="ПлатежнаяКарта"  Тогда
		Возврат  Перечисления.ТипыОплат.ПлатежнаяКарта;
	ИначеЕсли ТО="БанковскийКредит"  Тогда
		Возврат  Перечисления.ТипыОплат.БанковскийКредит;              
	Иначе
		Возврат  Перечисления.ТипыОплат.ПлатежнаяКарта;
	КонецЕсли; 		
КонецФункции	
Функция ПолучитьСпособРасчетаКомиссионногоВознаграждения(Способ,В8)  
	СТНДС=В8.XMLString(Способ);
	Если СТНДС="НеРассчитывается"  Тогда
		Возврат  Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается;
	ИначеЕсли СТНДС="НДС10"  Тогда
		Возврат  Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается;
	ИначеЕсли СТНДС="ПроцентОтРазностиСуммыПродажиИСуммыКомитента"  Тогда
		Возврат  Перечисления.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтРазностиСуммПродажиИПоступления;
	ИначеЕсли СТНДС="ПроцентОтСуммыПродажи"  Тогда
		Возврат  Перечисления.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтСуммыПродажи;
	Иначе
		Возврат  Перечисления.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается;
	КонецЕсли; 	 
КонецФункции


Функция ПолучитьПроцентПоСтавке(СтавкаНДС) Экспорт
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат 20;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Возврат 10;
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Возврат 18;
		
	КонецЕсли;
	
	Возврат 0;
	
